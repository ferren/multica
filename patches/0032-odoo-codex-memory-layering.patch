+// codexMemoryStoreDir puts the native Codex memory store beneath the existing
+// per-issue session store. This gives it the same (profile, agent, issue)
+// isolation and lifecycle: the normal session-store retention job removes both
+// together, and a plain host Codex run never discovers either store.
+func codexMemoryStoreDir(sharedHome, key string) string {
+	sessionStore := codexSessionStoreDir(sharedHome, key)
+	if sessionStore == "" {
+		return ""
+	}
+	return filepath.Join(sessionStore, "memories")
+}
+
+// prepareCodexMemoriesDir makes native Codex memory durable across fresh
+// local-directory/worktree task homes, without sharing it with another issue
+// or with the user's normal ~/.codex/memories. Managed task homes are reused,
+// so their already-local directory remains authoritative.
+//
+// Existing real directories are deliberately left in place. They may belong to
+// an in-flight task created by an older daemon; replacing them would be data
+// loss. New local task homes have no such directory and get the scoped link.
+func prepareCodexMemoriesDir(codexHome, sharedHome string, opts CodexHomeOptions, logger *slog.Logger) error {
+	dst := filepath.Join(codexHome, "memories")
+	if !codexMemoryEnabled() || !opts.IsLocalDirectory {
+		return os.MkdirAll(dst, 0o755)
+	}
+	storeDir := codexMemoryStoreDir(sharedHome, opts.SessionStoreKey)
+	if storeDir == "" {
+		return os.MkdirAll(dst, 0o755)
+	}
+
+	if fi, err := os.Lstat(dst); err == nil {
+		if fi.Mode()&os.ModeSymlink != 0 {
+			if target, readErr := os.Readlink(dst); readErr == nil && sameCodexPath(target, storeDir) {
+				return nil
+			}
+		}
+		if logger != nil {
+			logger.Warn("execenv: preserving existing task-local Codex memories instead of replacing them",
+				"codex_home", codexHome)
+		}
+		return nil
+	} else if !os.IsNotExist(err) {
+		return fmt.Errorf("stat codex memories dir %s: %w", dst, err)
+	}
+
+	if err := os.MkdirAll(storeDir, 0o755); err != nil {
+		return fmt.Errorf("create codex memory store %s: %w", storeDir, err)
+	}
+	if err := createDirLink(storeDir, dst); err != nil {
+		return fmt.Errorf("link codex memories dir %s: %w", dst, err)
+	}
+	return nil
+}
+
