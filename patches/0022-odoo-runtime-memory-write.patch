+		"---\nname: unmanaged\ndescription: d\nmetadata:\n  type: project\n---\n\nbody\n")
+	writeMemoryFile(t, dir, "no-frontmatter.md", "just text\n")
+
+	if !fileManagedByMultica(filepath.Join(dir, "managed.md")) {
+		t.Fatal("file with managed_by: multica should be recognized")
+	}
+	if fileManagedByMultica(filepath.Join(dir, "unmanaged.md")) {
