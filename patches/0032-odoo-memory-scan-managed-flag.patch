+func TestParseLocalMemoryFileManagedMarker(t *testing.T) {
+	// The scan report mirrors fileManagedByMultica's verdict so the server
+	// can flag locally-managed files without a failed delete first.
+	dir := t.TempDir()
+	writeMemoryFile(t, dir, "platform.md",
+		"---\nname: platform\ndescription: d\nmetadata:\n  type: project\n  managed_by: multica\n---\n\nbody\n")
+	info, _ := os.Stat(filepath.Join(dir, "platform.md"))
+	entry := parseLocalMemoryFile(dir, "platform.md", info)
+	if !entry.Managed {
+		t.Fatal("file with managed_by: multica must report Managed")
+	}
 }
 
