+		}
+	}()
+	// Give the failure+compaction time to start, then cancel mid-compaction.
+	time.Sleep(700 * time.Millisecond)
+	cancel()
+
+	select {
+	case result, ok := <-resultCh:
+		if !ok {
+			t.Fatal("result channel closed without a value")
+		}
+		if result.Status != "failed" {
+			t.Fatalf("expected the original failure to stand, got %+v", result)
+		}
+		if result.ResumeRejected || result.ResumeRejectedTransient {
+			t.Fatalf("cancellation must not classify the session, got %+v", result)
+		}
+		if !strings.Contains(result.Error, "ran out of room") {
+			t.Fatalf("expected the capacity failure to be preserved, got %q", result.Error)
+		}
+	case <-time.After(15 * time.Second):
+		t.Fatal("timeout waiting for result")
+	}
+	// The cancelled compaction must not have scheduled a relaunch. Give a
+	// grace margin for process teardown, then read the counter.
+	time.Sleep(300 * time.Millisecond)
+	if n := fakeCodexInvocations(t, dir); n != 1 {
+		t.Fatalf("a cancelled compaction must not relaunch, got %d invocations", n)
+	}
+}
