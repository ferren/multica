+// TestCodexContextCompactRecoveryContinuesOriginalThread is the success
+// path: capacity failure → thread/compact/start → item/completed
+// contextCompaction → relaunch resuming the SAME thread → turn succeeds.
+func TestCodexContextCompactRecoveryContinuesOriginalThread(t *testing.T) {
+	t.Parallel()
+	if runtime.GOOS == "windows" {
+		t.Skip("shell-script fixture is POSIX-only")
+	}
+
+	fakePath := writeFakeCodexAppServer(t, fakeCodexCompactPreamble+`
+if [ "$INV" = "1" ]; then
+`+fakeCodexCompactStartTurnAndServeFailure("turn-1")+fakeCodexCompactAcceptAndComplete+`
+  read line
+else
+`+fakeCodexCompactSucceedingTurn+`
+fi
+`)
+	dir := filepath.Dir(fakePath)
+	result := executeFakeCodex(t, fakePath, fakeCodexCompactOptions())
+
+	if result.Status != "completed" {
+		t.Fatalf("expected status=completed after compaction recovery, got %+v", result)
+	}
+	if result.SessionID != "thr_prior" {
+		t.Fatalf("expected continuation on the original thread, got session %q", result.SessionID)
+	}
+	if result.Output != "Continued after compaction" {
+		t.Fatalf("expected the continuation turn's deliverable, got %q", result.Output)
+	}
+	if result.ResumeRejected || result.ResumeRejectedTransient {
+		t.Fatalf("successful recovery must not flag the session, got %+v", result)
+	}
+	if n := fakeCodexInvocations(t, dir); n != 2 {
+		t.Fatalf("expected exactly one recovery relaunch (2 invocations), got %d", n)
+	}
+	compact := fakeCodexReadRequest(t, dir, "compact-start.json")
+	if compact["_method"] != "thread/compact/start" || compact["threadId"] != "thr_prior" {
+		t.Fatalf("expected thread/compact/start on thr_prior, got %v", compact)
+	}
+	resume2 := fakeCodexReadRequest(t, dir, "resume-2.json")
+	if resume2["_method"] != "thread/resume" || resume2["threadId"] != "thr_prior" {
+		t.Fatalf("expected the continuation to resume the compacted thread, got %v", resume2)
+	}
+}
