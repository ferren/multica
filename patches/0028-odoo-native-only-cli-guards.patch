+func TestRunProjectResourceUpdateWorktreeUsesOdooBackendRoute(t *testing.T) {
+	const projectID = "42"
+	const resourceID = "99"
+	var gotPath string
+	var gotMethod string
+	var gotMode any
+	mcpTestServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.Method == http.MethodGet {
+			_ = json.NewEncoder(w).Encode(map[string]any{
+				"resources": []map[string]any{{
+					"id":            resourceID,
+					"resource_type": "local_directory",
+					"resource_ref": map[string]any{
+						"local_path":     "/home/dev/workspace",
+						"daemon_id":      "daemon-1",
+						"label":          "",
+						"execution_mode": "in_place",
+					},
+				}},
+			})
+			return
+		}
+		gotPath = r.URL.Path
+		gotMethod = r.Method
+		var body map[string]any
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		if ref, ok := body["resource_ref"].(map[string]any); ok {
+			gotMode = ref["execution_mode"]
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"id":            resourceID,
+			"resource_type": "local_directory",
+		})
+	})
+	t.Setenv("MULTICA_BACKEND_MODE", "odoo")
+
+	cmd := projectOdooTestCmd()
+	cmd.Flags().Set("execution-mode", "worktree")
+	if _, err := captureStdout(t, func() error {
+		return runProjectResourceUpdate(cmd, []string{projectID, resourceID})
+	}); err != nil {
+		t.Fatalf("runProjectResourceUpdate: %v", err)
+	}
+	want := "/multica/agent/projects/" + projectID + "/resources/" + resourceID
+	if gotPath != want {
+		t.Fatalf("path = %q, want %q", gotPath, want)
+	}
+	if gotMethod != http.MethodPut {
+		t.Fatalf("method = %q, want PUT", gotMethod)
+	}
+	if gotMode != "worktree" {
+		t.Fatalf("execution_mode = %v, want worktree", gotMode)
+	}
+}
