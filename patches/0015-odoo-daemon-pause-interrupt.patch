Index: multica/server/internal/daemon/daemon.go
===================================================================
--- multica.orig/server/internal/daemon/daemon.go
+++ multica/server/internal/daemon/daemon.go
@@ -4778,7 +4778,12 @@ func shouldInterruptAgent(status string,
 	if err != nil {
 		return isTaskNotFoundError(err)
 	}
-	return isAgentTaskTerminal(status)
+	// "paused" is a held-but-resumable state: the running agent must stop so the
+	// task can be resumed later from its pinned session. It is intentionally NOT
+	// part of isAgentTaskTerminal — that set drives GC cleanup (gc.go), and a
+	// paused task's workdir/session must survive so resume can continue it. Only
+	// the live-agent interrupt decision widens to include "paused".
+	return isAgentTaskTerminal(status) || status == "paused"
 }
 
