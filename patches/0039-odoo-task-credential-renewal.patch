+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/multica-ai/multica/server/internal/cli"
+)
+
+func TestOdooTaskCredentialRenewalAcrossExpiry(t *testing.T) {
+	var mu sync.Mutex
+	valid := map[string]time.Time{}
+	var minted, business atomic.Int32
+	var revoked atomic.Bool
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.URL.Path == "/multica/daemon/agents/agent/token" {
+			if revoked.Load() {
+				w.WriteHeader(409)
+				return
+			}
+			n := minted.Add(1)
+			if n == 2 {
+				w.WriteHeader(503) // One transient failure before recovery.
+				return
+			}
+			var claim map[string]string
+			json.NewDecoder(r.Body).Decode(&claim)
+			if claim["dispatched_at"] != "2026-11-16T00:00:00Z" || claim["runtime_id"] != "rt" {
+				t.Error("renewal changed execution claim")
+			}
+			key := fmt.Sprintf("key-%d", n)
+			mu.Lock()
+			valid["Bearer token-"+key] = time.Now().Add(time.Second)
+			mu.Unlock()
+			json.NewEncoder(w).Encode(map[string]any{"access_token": "token-" + key,
+				"api_key": key, "expires_in": 1, "execution_bound": true})
+			return
+		}
+		business.Add(1)
+		token, key := r.Header.Get("X-GALAXY-ACCESS-TOKEN"), r.Header.Get("X-GALAXY-API-KEY")
+		mu.Lock()
+		deadline := valid[token]
+		mu.Unlock()
+		if revoked.Load() || token != "Bearer token-"+key || !time.Now().Before(deadline) || r.Header.Get("X-Agent-ID") != "agent" {
+			w.WriteHeader(401)
+			return
+		}
+		if r.URL.Path == "/multica/agent/upload-file" {
+			if err := r.ParseMultipartForm(4096); err != nil {
+				t.Error(err)
+			}
+			fmt.Fprint(w, `{"id":"attachment-1"}`)
+		} else {
+			fmt.Fprint(w, `{}`)
+		}
+	}))
+	defer srv.Close()
+	d := &Daemon{cfg: Config{WorkspacesRoot: t.TempDir(), ServerBaseURL: srv.URL},
+		client: NewClient(srv.URL), logger: slog.New(slog.NewTextHandler(io.Discard, nil))}
+	d.client.SetPathPrefix("/multica")
+	task := Task{ID: "task", AgentID: "agent", RuntimeID: "rt", DispatchedAt: "2026-11-16T00:00:00Z"}
+	_, path, stop, err := d.startOdooTaskCredentials(context.Background(), task)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stop()
+	client := cli.NewAPIClient(srv.URL, "", "stale-environment")
+	client.OdooBackend, client.PathPrefix, client.TaskCredentialFile = true, "/multica/agent", path
+	client.TaskID, client.AgentID = "task", "agent"
+	// Foreground deterministic fixture only; never launches a paid agent.
+	for until := time.Now().Add(2200 * time.Millisecond); time.Now().Before(until); {
+		if err := client.GetJSON(context.Background(), "/api/issues/1", nil); err != nil {
+			t.Fatal(err)
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	if minted.Load() < 4 {
+		t.Fatalf("did not rotate multiple times: %d", minted.Load())
+	}
+	before := business.Load()
+	for _, err := range []error{
+		client.PatchJSON(context.Background(), "/api/issues/1", map[string]string{"status": "in_review"}, nil),
+		client.PostJSON(context.Background(), "/api/issues/1/comments", map[string]string{"content": "finished"}, nil),
+	} {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := client.UploadIssueAttachment(context.Background(), []byte("result"), "result.txt", "1"); err != nil {
+		t.Fatal(err)
+	}
+	if business.Load()-before != 3 {
+		t.Fatal("business writes were repeated")
+	}
+	revoked.Store(true)
+	if err := client.PostJSON(context.Background(), "/api/issues/1/comments", nil, nil); err == nil {
+		t.Fatal("revoked execution was accepted")
+	}
+	stop()
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatal("credential not removed on stop")
+	}
+	// A resumed process gets a new path and pair, never the previous file.
+	revoked.Store(false)
+	_, resumedPath, resumedStop, err := d.startOdooTaskCredentials(context.Background(), task)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resumedStop()
+	if resumedPath == path {
+		t.Fatal("resume reused old credential path")
+	}
+}
+
+func TestOdooTaskCredentialRefreshStopsAfterBoundedFailures(t *testing.T) {
+	for _, status := range []int{409, 503} {
+		t.Run(fmt.Sprint(status), func(t *testing.T) {
+			var attempts atomic.Int32
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				attempts.Add(1)
+				w.WriteHeader(status)
+			}))
+			defer srv.Close()
+			d := &Daemon{cfg: Config{ServerBaseURL: srv.URL}, client: NewClient(srv.URL),
+				logger: slog.New(slog.NewTextHandler(io.Discard, nil))}
+			d.client.SetPathPrefix("/multica")
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			d.refreshOdooTaskCredentials(ctx, Task{ID: "task", AgentID: "agent", RuntimeID: "rt", DispatchedAt: "2026-11-16T00:00:00Z"},
+				"unused", time.Now(), time.Millisecond)
+			want := int32(1)
+			if status == 503 {
+				want = 12
+			}
+			if ctx.Err() != nil || attempts.Load() != want {
+				t.Fatalf("unbounded or premature retries: %d, want %d", attempts.Load(), want)
+			}
+		})
+	}
+}
+
+func TestOdooTaskCredentialRequiresBoundBackend(t *testing.T) {
+	for _, payload := range []string{
+		`{"access_token":"old","api_key":"old-key","expires_in":7200}`,
+		`{"access_token":"new","api_key":"","expires_in":7200,"execution_bound":true}`,
+		`{"access_token":"new","api_key":"key","expires_in":0,"execution_bound":true}`,
+	} {
+		t.Run(payload, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				fmt.Fprint(w, payload)
+			}))
+			defer srv.Close()
+			root := t.TempDir()
+			d := &Daemon{cfg: Config{WorkspacesRoot: root, ServerBaseURL: srv.URL}, client: NewClient(srv.URL)}
+			d.client.SetPathPrefix("/multica")
+			d.client.accessToken, d.client.apiKey = "shared-daemon-token", "shared-daemon-key"
+			credential, path, stop, err := d.startOdooTaskCredentials(context.Background(),
+				Task{ID: "task", AgentID: "agent", RuntimeID: "rt", DispatchedAt: "2026-11-16T00:00:00Z"})
+			if err == nil || path != "" || stop != nil || credential.AccessToken != "" {
+				t.Fatal("invalid scoped credential fell back to shared daemon identity")
+			}
+			entries, _ := os.ReadDir(root)
+			if len(entries) != 0 {
+				t.Fatal("failed initialization left credentials on disk")
+			}
+		})
+	}
+}
