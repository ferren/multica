+// TestCodexContextCapacityFailure is the classifier matrix: the typed
+// context_window_exceeded value and the exact fixed message qualify;
+// neighbouring error classes stay out.
+func TestCodexContextCapacityFailure(t *testing.T) {
+	t.Parallel()
+
+	cases := []struct {
+		name    string
+		info    string
+		message string
+		want    bool
+	}{
+		{"typed", "context_window_exceeded", "", true},
+		{"typed with whitespace", " context_window_exceeded ", "", true},
+		{"fixed message", "", "Codex ran out of room in the model's context window. Start a new thread or clear earlier history before retrying.", true},
+		{"fixed message case-insensitive", "", "CODEX RAN OUT OF ROOM IN THE MODEL'S CONTEXT WINDOW", true},
+		{"usage limit", "usage_limit_exceeded", "usage limit", false},
+		{"session budget", "session_budget_exceeded", "", false},
+		{"rate limit", "rate_limit_exceeded", "rate limit exceeded: 429", false},
+		{"untyped other", "", "internal error", false},
+		{"provider 400 without the marker", "", "unexpected status 400 Bad Request: context_length_exceeded", false},
+		{"empty", "", "", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			if got := codexContextCapacityFailure(tc.info, tc.message); got != tc.want {
+				t.Errorf("codexContextCapacityFailure(%q, %q) = %v, want %v", tc.info, tc.message, got, tc.want)
+			}
+		})
+	}
+}
