+package daemon
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+func TestOdooWakeupURL(t *testing.T) {
+	u, origin, err := odooWakeupURL("https://example.com/base", "odoo_db", "daemon-a", []string{"2", "1"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, _ := url.Parse(u)
+	if parsed.Scheme != "wss" || parsed.Path != "/base/multica/daemon/ws" || origin != "https://example.com" || parsed.Query().Get("runtime_ids") != "1,2" || parsed.Query().Get("db") != "odoo_db" {
+		t.Fatalf("unexpected URL: %s, origin %s", u, origin)
+	}
+	if _, _, err := odooWakeupURL("file:///tmp/test", "", "", nil); err == nil {
+		t.Fatal("accepted invalid server URL")
+	}
+}
+
+func newOdooWakeupTestDaemon(t *testing.T, baseURL string) *Daemon {
+	t.Helper()
+	d := New(Config{BackendMode: "odoo", ServerBaseURL: baseURL, DaemonID: "daemon-test", WorkspacesRoot: t.TempDir(), MaxConcurrentTasks: 1, PollInterval: time.Hour}, slog.New(slog.NewTextHandler(noopWriter{}, nil)))
+	d.client.accessToken, d.client.apiKey = "access-test", "key-test"
+	d.oursRuntimeIDs["1"] = true
+	return d
+}
+
+func TestOdooWakeupReadyHintsAndTokenRotation(t *testing.T) {
+	release := make(chan struct{})
+	serverDone := make(chan struct{})
+	upgrader := websocket.Upgrader{}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer close(serverDone)
+		if r.URL.Path != "/multica/daemon/ws" || r.Header.Get("X-GALAXY-ACCESS-TOKEN") != "Bearer access-test" || r.Header.Get("X-GALAXY-API-KEY") != "key-test" || r.Header.Get("Cookie") != "" {
+			t.Error("incorrect handshake credentials or cookie")
+		}
+		conn, err := upgrader.Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		conn.WriteJSON(map[string]string{"type": "ready"})
+		<-release
+		conn.WriteJSON(map[string]string{"type": "task_available"})
+		for {
+			if _, _, err := conn.ReadMessage(); err != nil {
+				return
+			}
+		}
+	}))
+	defer srv.Close()
+	d := newOdooWakeupTestDaemon(t, srv.URL)
+	wakeups := make(chan taskWakeup, 1)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := d.runOdooWakeupConnection(ctx, []string{"1"}, wakeups, nil); done <- err }()
+	select {
+	case <-wakeups:
+	case <-ctx.Done():
+		t.Fatal("ready did not wake REST claim")
+	}
+	close(release)
+	select {
+	case <-wakeups:
+	case <-ctx.Done():
+		t.Fatal("task hint did not wake REST claim")
+	}
+	d.client.tokenMu.Lock()
+	d.client.accessToken = "rotated"
+	d.client.tokenMu.Unlock()
+	if err := <-done; !errors.Is(err, errOdooWSTokenChanged) {
+		t.Fatalf("rotation did not reconnect: %v", err)
+	}
+	<-serverDone
+}
+
+func TestOdooWakeupReconnectAndConcurrentPolling(t *testing.T) {
+	var claims atomic.Int32
+	connections := make(chan *websocket.Conn, 4)
+	serverDone := make(chan struct{}, 4)
+	upgrader := websocket.Upgrader{}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/multica/daemon/tasks/claim" {
+			claims.Add(1)
+			w.Header().Set("Content-Type", "application/json")
+			w.Write([]byte(`{"tasks":[]}`))
+			return
+		}
+		conn, err := upgrader.Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer func() { conn.Close(); serverDone <- struct{}{} }()
+		conn.WriteJSON(map[string]string{"type": "ready"})
+		connections <- conn
+		for {
+			if _, _, err := conn.ReadMessage(); err != nil {
+				return
+			}
+		}
+	}))
+	defer srv.Close()
+	d := newOdooWakeupTestDaemon(t, srv.URL)
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	wakeups := make(chan taskWakeup, 256)
+	wsDone, pollDone := make(chan struct{}), make(chan struct{})
+	go func() { defer close(wsDone); d.odooTaskWakeupLoop(ctx, wakeups) }()
+	go func() { defer close(pollDone); d.pollLoop(ctx, wakeups) }()
+	var conn *websocket.Conn
+	select {
+	case conn = <-connections:
+	case <-ctx.Done():
+		t.Fatal("no connection")
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for claims.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	before := claims.Load()
+	for i := 0; i < 20; i++ {
+		conn.WriteJSON(map[string]string{"type": "task_available"})
+	}
+	deadline = time.Now().Add(2 * time.Second)
+	for claims.Load() <= before && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if claims.Load() <= before {
+		t.Error("hints did not wake existing REST poller")
+	}
+	before = claims.Load()
+	conn.Close()
+	select {
+	case <-connections:
+	case <-ctx.Done():
+		t.Fatal("no reconnect")
+	}
+	deadline = time.Now().Add(2 * time.Second)
+	for claims.Load() <= before && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if claims.Load() <= before {
+		t.Error("reconnect did not claim backlog")
+	}
+	cancel()
+	<-wsDone
+	<-pollDone
+	<-serverDone
+	<-serverDone
+}
+
+func TestOdooWakeupUnauthorizedRefreshAndPollingFallback(t *testing.T) {
+	var refreshes atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/multica/daemon/tasks/claim" {
+			w.Header().Set("Content-Type", "application/json")
+			w.Write([]byte(`{"tasks":[]}`))
+			return
+		}
+		w.WriteHeader(http.StatusUnauthorized)
+	}))
+	defer srv.Close()
+	d := newOdooWakeupTestDaemon(t, srv.URL)
+	d.client.SetOnTokenError(func() { refreshes.Add(1) })
+	_, err := d.runOdooWakeupConnection(context.Background(), []string{"1"}, make(chan taskWakeup, 1), nil)
+	if err == nil || refreshes.Load() != 1 {
+		t.Fatalf("invalid token should refresh once: %v, %d", err, refreshes.Load())
+	}
+	if _, err := d.ClaimTasksWSFirst(context.Background(), "daemon-test", []string{"1"}, 1); err != nil {
+		t.Fatalf("REST claim must remain available: %v", err)
+	}
+}
+
+func TestOdooWakeupUnavailableKeepsPeriodicClaims(t *testing.T) {
+	for _, status := range []int{http.StatusNotFound, http.StatusServiceUnavailable} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			var claims atomic.Int32
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path == "/multica/daemon/tasks/claim" {
+					claims.Add(1)
+					w.Header().Set("Content-Type", "application/json")
+					w.Write([]byte(`{"tasks":[]}`))
+					return
+				}
+				w.WriteHeader(status)
+			}))
+			defer srv.Close()
+			d := newOdooWakeupTestDaemon(t, srv.URL)
+			d.cfg.PollInterval = 20 * time.Millisecond
+			ctx, cancel := context.WithCancel(context.Background())
+			wakeups := make(chan taskWakeup, 1)
+			wsDone, pollDone := make(chan struct{}), make(chan struct{})
+			go func() { defer close(wsDone); d.odooTaskWakeupLoop(ctx, wakeups) }()
+			go func() { defer close(pollDone); d.pollLoop(ctx, wakeups) }()
+			deadline := time.Now().Add(time.Second)
+			for claims.Load() < 2 && time.Now().Before(deadline) {
+				time.Sleep(time.Millisecond)
+			}
+			cancel()
+			<-wsDone
+			<-pollDone
+			if claims.Load() < 2 {
+				t.Fatalf("WS status %d stopped periodic REST claims", status)
+			}
+		})
+	}
+}
