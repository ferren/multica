--- /dev/null
+++ multica/server/internal/daemon/odoo_wakeup.go
@@ -0,0 +1,168 @@
+package daemon
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+var errOdooWSTokenChanged = errors.New("odoo websocket credentials changed")
+
+// This connection only carries hints. Never attach wsRPC: the persistent
+// Odoo queue and the existing serialized REST claim poller own task delivery.
+func (d *Daemon) odooTaskWakeupLoop(ctx context.Context, taskWakeups chan<- taskWakeup) {
+	runtimeChanges, unsubscribe := d.runtimeSet.Subscribe()
+	defer unsubscribe()
+	backoff := time.Second
+	for ctx.Err() == nil {
+		runtimeIDs := d.allRuntimeIDs()
+		var connectedFor time.Duration
+		var err error
+		if len(runtimeIDs) != 0 {
+			connectedFor, err = d.runOdooWakeupConnection(ctx, runtimeIDs, taskWakeups, runtimeChanges)
+		}
+		if ctx.Err() != nil {
+			return
+		}
+		if errors.Is(err, errRuntimeSetChanged) || errors.Is(err, errOdooWSTokenChanged) {
+			backoff = time.Second
+			continue
+		}
+		if shouldResetTaskWakeupBackoff(connectedFor) {
+			backoff = time.Second
+		}
+		if err != nil {
+			d.logger.Debug("odoo websocket unavailable; REST polling remains active", "error", err, "retry_in", backoff)
+		}
+		if sleepWithContextOrRuntimeChange(ctx, jitterDuration(backoff), runtimeChanges) != nil {
+			return
+		}
+		backoff *= 2
+		if backoff > taskWakeupMaxBackoff {
+			backoff = taskWakeupMaxBackoff
+		}
+	}
+}
+
+func odooWakeupURL(baseURL, dbName, daemonID string, runtimeIDs []string) (string, string, error) {
+	u, err := url.Parse(baseURL)
+	if err != nil || u.Host == "" || (u.Scheme != "http" && u.Scheme != "https") {
+		return "", "", fmt.Errorf("invalid Odoo server URL")
+	}
+	origin := u.Scheme + "://" + u.Host
+	if u.Scheme == "https" {
+		u.Scheme = "wss"
+	} else {
+		u.Scheme = "ws"
+	}
+	u.Path = strings.TrimRight(u.Path, "/") + "/multica/daemon/ws"
+	u.RawPath = ""
+	q := u.Query()
+	q.Set("daemon_id", daemonID)
+	ids := append([]string(nil), runtimeIDs...)
+	sort.Strings(ids)
+	q.Set("runtime_ids", strings.Join(ids, ","))
+	if dbName != "" {
+		q.Set("db", dbName)
+	}
+	u.RawQuery = q.Encode()
+	return u.String(), origin, nil
+}
+
+func (d *Daemon) runOdooWakeupConnection(ctx context.Context, runtimeIDs []string, wakeups chan<- taskWakeup, runtimeChanges <-chan struct{}) (time.Duration, error) {
+	wsURL, origin, err := odooWakeupURL(d.cfg.ServerBaseURL, d.cfg.DBName, d.cfg.DaemonID, runtimeIDs)
+	if err != nil {
+		return 0, err
+	}
+	accessToken, apiKey := d.client.OdooCredentials()
+	headers := make(http.Header)
+	headers.Set("Origin", origin)
+	headers.Set("X-GALAXY-ACCESS-TOKEN", "Bearer "+accessToken)
+	headers.Set("X-GALAXY-API-KEY", apiKey)
+	dialer := websocket.Dialer{HandshakeTimeout: 10 * time.Second, Proxy: http.ProxyFromEnvironment}
+	conn, resp, err := dialer.DialContext(ctx, wsURL, headers)
+	if resp != nil && resp.Body != nil {
+		resp.Body.Close()
+	}
+	if err != nil {
+		if resp != nil && resp.StatusCode == http.StatusUnauthorized && d.client.onTokenError != nil {
+			d.client.onTokenError()
+		}
+		return 0, err
+	}
+	connectedAt := time.Now()
+	conn.SetReadLimit(4096)
+	conn.SetReadDeadline(time.Now().Add(45 * time.Second))
+	conn.SetPongHandler(func(string) error {
+		return conn.SetReadDeadline(time.Now().Add(45 * time.Second))
+	})
+	readDone := make(chan error, 1)
+	go func() {
+		for {
+			var message struct {
+				Type string `json:"type"`
+			}
+			if err := conn.ReadJSON(&message); err != nil {
+				readDone <- err
+				return
+			}
+			conn.SetReadDeadline(time.Now().Add(45 * time.Second))
+			switch message.Type {
+			case "ready", "task_available":
+				// The ready frame follows server-side subscription. An immediate
+				// REST claim recovers work queued during the connection gap.
+				signalTaskWakeup(wakeups, "")
+			case "pong":
+			default:
+				readDone <- fmt.Errorf("unsupported Odoo websocket message")
+				return
+			}
+		}
+	}()
+	readerJoined := false
+	defer func() {
+		conn.Close()
+		if !readerJoined {
+			<-readDone
+		}
+	}()
+	d.logger.Info("odoo task notification websocket connected", "runtimes", len(runtimeIDs))
+	// The writer stays in this goroutine. A cheap credential check causes
+	// reconnect within one second of token rotation, including REST 401 refresh.
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	nextPing := time.Now().Add(15 * time.Second)
+	for {
+		select {
+		case <-ctx.Done():
+			return time.Since(connectedAt), ctx.Err()
+		case <-runtimeChanges:
+			return time.Since(connectedAt), errRuntimeSetChanged
+		case err := <-readDone:
+			readerJoined = true
+			if websocket.IsCloseError(err, websocket.ClosePolicyViolation) && d.client.onTokenError != nil {
+				d.client.onTokenError()
+			}
+			return time.Since(connectedAt), err
+		case now := <-ticker.C:
+			newToken, newKey := d.client.OdooCredentials()
+			if newToken != accessToken || newKey != apiKey {
+				return time.Since(connectedAt), errOdooWSTokenChanged
+			}
+			if !now.Before(nextPing) {
+				conn.SetWriteDeadline(now.Add(5 * time.Second))
+				if err := conn.WriteJSON(map[string]string{"type": "ping"}); err != nil {
+					return time.Since(connectedAt), err
+				}
+				nextPing = now.Add(15 * time.Second)
+			}
+		}
+	}
+}
