--- /dev/null
+++ b/server/cmd/multica/cmd_issue_ask_human.go
@@ -0,0 +1,86 @@
+package main
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/multica-ai/multica/server/internal/cli"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	cmd := &cobra.Command{
+		Use:   "ask-human <issue-id>",
+		Short: "Ask the issue requester in Odoo Discuss and wait for their reply",
+		Args:  cobra.ExactArgs(1),
+		RunE:  runIssueAskHuman,
+	}
+	cmd.Flags().String("question-file", "", "Read the question from a UTF-8 file")
+	issueCmd.AddCommand(cmd)
+}
+
+func runIssueAskHuman(cmd *cobra.Command, args []string) error {
+	client, err := newAPIClient(cmd)
+	if err != nil {
+		return err
+	}
+	if !client.OdooBackend || client.TaskID == "" {
+		return fmt.Errorf("ask-human requires an Odoo issue execution")
+	}
+	issueID, err := strconv.ParseInt(args[0], 10, 64)
+	if err != nil || issueID <= 0 {
+		return fmt.Errorf("ask-human requires the current numeric Odoo issue ID")
+	}
+	question, _, err := resolveTextFlag(cmd, "question")
+	if err != nil {
+		return err
+	}
+	if strings.TrimSpace(question) == "" {
+		return fmt.Errorf("--question-file is required")
+	}
+	path := fmt.Sprintf("/api/issues/%d/ask-human", issueID)
+	var sent struct {
+		QuestionID int64 `json:"question_id"`
+	}
+	ctx, cancel := cli.APIContext(cmd.Context())
+	err = client.PostJSON(ctx, path, map[string]string{"question": question}, &sent)
+	cancel()
+	if err != nil {
+		return fmt.Errorf("send Discuss question: %w", err)
+	}
+	if sent.QuestionID <= 0 {
+		return fmt.Errorf("Odoo did not return a question ID")
+	}
+	path += "/" + strconv.FormatInt(sent.QuestionID, 10)
+	ticker := time.NewTicker(2 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-cmd.Context().Done():
+			return cmd.Context().Err()
+		case <-ticker.C:
+		}
+		var reply struct {
+			State  string `json:"state"`
+			Answer string `json:"answer"`
+		}
+		ctx, cancel := cli.APIContext(cmd.Context())
+		err := client.PostJSON(ctx, path, nil, &reply)
+		cancel()
+		if err != nil {
+			return fmt.Errorf("read Discuss reply: %w", err)
+		}
+		switch reply.State {
+		case "waiting":
+			continue
+		case "answered":
+			return cli.PrintJSON(cmd.OutOrStdout(), reply)
+		case "waiting_human":
+			return cli.PrintJSON(cmd.OutOrStdout(), reply)
+		default:
+			return fmt.Errorf("unexpected Discuss reply state %q", reply.State)
+		}
+	}
+}
