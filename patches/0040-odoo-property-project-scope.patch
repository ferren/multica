+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/spf13/cobra"
+)
+
+func TestPropertyNameAmbiguityRequiresID(t *testing.T) {
+	properties := []propertyDTO{{ID: "one", Name: "Severity"}, {ID: "two", Name: "severity"}}
+	if _, err := resolvePropertyRef(properties, "Severity"); err == nil || !strings.Contains(err.Error(), "ambiguous") {
+		t.Fatalf("expected ambiguous name, got %v", err)
+	}
+	if got, err := resolvePropertyRef(properties, "two"); err != nil || got.ID != "two" {
+		t.Fatalf("exact ID must win: got %v, %v", got, err)
+	}
+}
+
+func TestPropertyCreateOdooProject(t *testing.T) {
+	var got map[string]any
+	mcpTestServer(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.URL.Path != "/multica/agent/properties" {
+			t.Errorf("unexpected %s %s", r.Method, r.URL.Path)
+		}
+		if err := json.NewDecoder(r.Body).Decode(&got); err != nil {
+			t.Fatal(err)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusCreated)
+		_ = json.NewEncoder(w).Encode(propertyDTO{ID: "new", Name: "Severity", Type: "text"})
+	})
+	t.Setenv("MULTICA_BACKEND_MODE", "odoo")
+	cmd := &cobra.Command{}
+	for key, value := range map[string]string{"workspace-id": "", "profile": "", "server-url": "", "output": "json", "name": "Severity", "type": "text", "description": "", "icon": "", "project": "42"} {
+		cmd.Flags().String(key, value, "")
+	}
+	cmd.Flags().StringArray("option", nil, "")
+	if _, err := captureStdout(t, func() error { return runPropertyCreate(cmd, nil) }); err != nil {
+		t.Fatal(err)
+	}
+	if got["project_id"] != "42" || got["name"] != "Severity" {
+		t.Fatalf("unexpected payload: %v", got)
+	}
+}
