+// Codex's project-level skills live in .agents/skills per the official
+// convention (developers.openai.com/codex/skills), not in a project
+// .codex/skills mirror of the user-level compat dir. The list must surface
+// them with root=project and an absolute source_path (the Odoo side
+// prefix-matches it against local_directory.local_path), the pre-fix
+// .codex/skills project layout must no longer be scanned, and the
+// home-level universal ~/.agents/skills root must keep working for codex.
+func TestListRuntimeLocalSkills_CodexProjectRoot(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("CODEX_HOME", filepath.Join(home, ".codex"))
+
+	proj := t.TempDir()
+	writeTestLocalSkill(t, filepath.Join(proj, ".agents", "skills"), "proj-helper", map[string]string{
+		"SKILL.md":      "---\nname: Proj Helper\ndescription: Project-level skill\n---\n# Proj Helper\n",
+		"docs/notes.md": "notes",
+	})
+	// Old, never-official project layout: must not surface anymore.
+	writeTestLocalSkill(t, filepath.Join(proj, ".codex", "skills"), "legacy-helper", map[string]string{
+		"SKILL.md": "---\nname: Legacy Helper\n---\n",
+	})
+	writeTestLocalSkill(t, filepath.Join(home, ".agents", "skills"), "home-helper", map[string]string{
+		"SKILL.md": "---\nname: Home Helper\n---\n",
+	})
+
+	skills, supported, err := listRuntimeLocalSkills("codex", []string{proj})
+	if err != nil {
+		t.Fatalf("listRuntimeLocalSkills: %v", err)
+	}
+	if !supported {
+		t.Fatal("codex should be supported")
+	}
+
+	byKey := make(map[string]runtimeLocalSkillSummary, len(skills))
+	for _, s := range skills {
+		byKey[s.Key] = s
+	}
+	projSkill, ok := byKey["proj-helper"]
+	if !ok {
+		t.Fatalf("project .agents/skills skill missing: %#v", skills)
+	}
+	if projSkill.Root != localSkillRootProject {
+		t.Fatalf("root = %q, want %q", projSkill.Root, localSkillRootProject)
+	}
+	wantPath := filepath.ToSlash(filepath.Join(proj, ".agents", "skills", "proj-helper"))
+	if projSkill.SourcePath != wantPath {
+		t.Fatalf("source_path = %q, want absolute %q", projSkill.SourcePath, wantPath)
+	}
+	if projSkill.FileCount != 2 {
+		t.Fatalf("file_count = %d, want 2", projSkill.FileCount)
+	}
+	if _, ok := byKey["legacy-helper"]; ok {
+		t.Fatalf("legacy <project>/.codex/skills skill must not be listed: %#v", skills)
+	}
+	homeSkill, ok := byKey["home-helper"]
+	if !ok {
+		t.Fatalf("universal ~/.agents/skills skill missing for codex: %#v", skills)
+	}
+	if homeSkill.Root != localSkillRootUniversal {
+		t.Fatalf("root = %q, want %q", homeSkill.Root, localSkillRootUniversal)
+	}
+	if len(skills) != 2 {
+		t.Fatalf("expected 2 skills, got %d: %#v", len(skills), skills)
+	}
+
+	bundle, supported, err := loadRuntimeLocalSkillBundle("codex", "proj-helper", []string{proj})
+	if err != nil || !supported {
+		t.Fatalf("loadRuntimeLocalSkillBundle: supported=%v err=%v", supported, err)
+	}
+	if !strings.Contains(bundle.Content, "# Proj Helper") {
+		t.Fatalf("bundle content = %q, want project skill body", bundle.Content)
+	}
+	if len(bundle.Files) != 1 || bundle.Files[0].Path != "docs/notes.md" {
+		t.Fatalf("bundle files = %#v, want docs/notes.md", bundle.Files)
+	}
+}
+
+// A same-key skill in the user-level provider root must keep winning over
+// the project .agents/skills copy, and load must agree with the list.
+func TestLocalSkills_CodexProviderRootWinsOverProject(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("CODEX_HOME", filepath.Join(home, ".codex"))
+
+	proj := t.TempDir()
+	writeTestLocalSkill(t, filepath.Join(home, ".codex", "skills"), "dup", map[string]string{
+		"SKILL.md": "---\nname: Provider Dup\n---\n# provider copy\n",
+	})
+	writeTestLocalSkill(t, filepath.Join(proj, ".agents", "skills"), "dup", map[string]string{
+		"SKILL.md": "---\nname: Project Dup\n---\n# project copy\n",
+	})
+	writeTestLocalSkill(t, filepath.Join(home, ".agents", "skills"), "dup", map[string]string{
+		"SKILL.md": "---\nname: Universal Dup\n---\n# universal copy\n",
+	})
+
+	skills, _, err := listRuntimeLocalSkills("codex", []string{proj})
+	if err != nil {
+		t.Fatalf("listRuntimeLocalSkills: %v", err)
+	}
+	if len(skills) != 1 {
+		t.Fatalf("expected 1 skill, got %d: %#v", len(skills), skills)
+	}
+	if skills[0].Root != localSkillRootProvider {
+		t.Fatalf("root = %q, want %q", skills[0].Root, localSkillRootProvider)
+	}
+
+	bundle, _, err := loadRuntimeLocalSkillBundle("codex", "dup", []string{proj})
+	if err != nil {
+		t.Fatalf("loadRuntimeLocalSkillBundle: %v", err)
+	}
+	if !strings.Contains(bundle.Content, "# provider copy") {
+		t.Fatalf("bundle content = %q, want provider copy", bundle.Content)
+	}
+}
+
+// Claude's project-level mapping stays .claude/skills (unchanged by the
+// codex .agents/skills switch).
+func TestListRuntimeLocalSkills_ClaudeProjectRoot(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+
+	proj := t.TempDir()
+	writeTestLocalSkill(t, filepath.Join(proj, ".claude", "skills"), "review-helper", map[string]string{
+		"SKILL.md": "---\nname: Review Helper\n---\n# Review Helper\n",
+	})
+
+	skills, supported, err := listRuntimeLocalSkills("claude", []string{proj})
+	if err != nil {
+		t.Fatalf("listRuntimeLocalSkills: %v", err)
+	}
+	if !supported {
+		t.Fatal("claude should be supported")
+	}
+	if len(skills) != 1 {
+		t.Fatalf("expected 1 skill, got %d: %#v", len(skills), skills)
+	}
+	if skills[0].Key != "review-helper" {
+		t.Fatalf("key = %q, want review-helper", skills[0].Key)
+	}
+	if skills[0].Root != localSkillRootProject {
+		t.Fatalf("root = %q, want %q", skills[0].Root, localSkillRootProject)
+	}
+	wantPath := filepath.ToSlash(filepath.Join(proj, ".claude", "skills", "review-helper"))
+	if skills[0].SourcePath != wantPath {
+		t.Fatalf("source_path = %q, want %q", skills[0].SourcePath, wantPath)
+	}
+}
