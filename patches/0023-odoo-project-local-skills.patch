+// providerProjectSkillRelPath returns the relative path from a project
+// root to the provider's project-local skills directory. Returns false for
+// providers with no known project-level skills convention.
+//
+// Project-level directories mirror the user-level layout but are rooted in
+// each project's workdir rather than $HOME. For providers whose user-level
+// path depends on an environment variable (codex, grok, qwen), the project
+// convention is the default dot-directory regardless of the env var.
+func providerProjectSkillRelPath(provider string) (string, bool) {
+	switch provider {
+	case "claude":
+		return ".claude/skills", true
+	case "codebuddy":
+		return ".codebuddy/skills", true
+	case "codex":
+		return ".codex/skills", true
+	case "copilot":
+		return ".copilot/skills", true
+	case "opencode":
+		return ".opencode/skills", true
+	case "deveco":
+		return ".deveco/skills", true
+	case "openclaw":
+		return ".openclaw/skills", true
+	case "pi":
+		return ".pi/agent/skills", true
+	case "cursor":
+		return ".cursor/skills", true
+	case "hermes":
+		return ".hermes/skills", true
+	case "kimi":
+		return ".kimi/skills", true
+	case "kiro":
+		return ".kiro/skills", true
+	case "qoder":
+		return ".qoder/skills", true
+	case "traecli":
+		return ".traecli/skills", true
+	case "antigravity":
+		return ".gemini/antigravity-cli/skills", true
+	case "grok":
+		return ".grok/skills", true
+	case "qwen":
+		return ".qwen/skills", true
+	default:
+		return "", false
+	}
+}
