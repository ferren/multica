+// TestCodexSupplementRefusedWhileCompacting pins the supplement gate: a steer
+// admitted during compaction would target a non-steerable turn.
+func TestCodexSupplementRefusedWhileCompacting(t *testing.T) {
+	t.Parallel()
+	c, _, _ := newTestCodexClient(t)
+	w := newCodexCompactWatch()
+	c.armCompactWatch(w)
+	if !c.isCompacting() {
+		t.Fatal("armed unresolved watch must report compacting")
+	}
+	if err := supplementCodexTurn(context.Background(), c, "extra"); err == nil || !strings.Contains(err.Error(), "compacting") {
+		t.Fatalf("expected supplement refusal while compacting, got %v", err)
+	}
+	w.resolveTerminal(codexCompactResult{kind: codexCompactSucceeded})
+	if c.isCompacting() {
+		t.Fatal("resolved watch must stop reporting compacting")
+	}
+}
