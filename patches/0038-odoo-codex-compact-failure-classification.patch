+// Failure events carry their own error info; the preceding capacity failure
+// must not turn an unrelated provider/configuration failure into retirement.
+func TestCodexContextCompactAsyncFailureClassification(t *testing.T) {
+	t.Parallel()
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX fixture")
+	}
+	cases := []struct {
+		name, info, detail string
+		permanent          bool
+	}{
+		{"retired route", "", codexRetiredCompactionLiveError, false},
+		{"model unavailable", "modelNotFound", "summarization model unavailable", false},
+		{"quota", "usageLimitExceeded", "quota reached", false},
+		{"network", "", "stream disconnected", false},
+		{"unknown", "other", "unspecified failure", false},
+		{"capacity", "contextWindowExceeded", "capacity reached", true},
+		{"capacity prose", "", codexContextCapacityMessageMarker, true},
+	}
+	for _, method := range []string{"turn/completed", "error"} {
+		for _, tc := range cases {
+			t.Run(method+"/"+tc.name, func(t *testing.T) {
+				t.Parallel()
+				errorData := map[string]any{"message": tc.detail}
+				if tc.info != "" {
+					errorData["codexErrorInfo"] = tc.info
+				}
+				params := map[string]any{"threadId": "thr_prior"}
+				if method == "turn/completed" {
+					params["turn"] = map[string]any{"id": "turn-compact", "status": "failed", "error": errorData}
+				} else {
+					params["turnId"], params["error"], params["willRetry"] = "turn-compact", errorData, false
+				}
+				event, err := json.Marshal(map[string]any{"jsonrpc": "2.0", "method": method, "params": params})
+				if err != nil {
+					t.Fatal(err)
+				}
+				fakePath := writeFakeCodexAppServer(t, fakeCodexCompactPreamble+
+					fakeCodexCompactStartTurnAndServeFailure("turn-1")+`
+read line
+echo '{"jsonrpc":"2.0","id":4,"result":{}}'
+echo '{"jsonrpc":"2.0","method":"turn/started","params":{"threadId":"thr_prior","turn":{"id":"turn-compact"}}}'
+`+fakeCodexCompactHeredoc(string(event)+"\n")+"read line\n")
+				result := executeFakeCodex(t, fakePath, fakeCodexCompactOptions())
+				if result.Status != "failed" || result.SessionID != "thr_prior" ||
+					result.ResumeRejected != tc.permanent || result.ResumeRejectedTransient == tc.permanent {
+					t.Fatalf("permanent=%v: unexpected failure classification: %+v", tc.permanent, result)
+				}
+				if !strings.Contains(result.Error, tc.detail) {
+					t.Fatalf("lost provider diagnostics: %q", result.Error)
+				}
+				if n := fakeCodexInvocations(t, filepath.Dir(fakePath)); n != 1 {
+					t.Fatalf("failed compaction must not replay the turn, got %d launches", n)
+				}
+			})
+		}
+	}
+}
