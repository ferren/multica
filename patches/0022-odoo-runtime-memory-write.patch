+func TestRenderMemoryFileHasManagedByMarker(t *testing.T) {
+	raw, err := renderMemoryFile("redis-session-required", "一句话摘要", "project", "正文内容")
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(raw)
+	if !strings.HasPrefix(text, "---\n") {
+		t.Fatalf("missing frontmatter delimiter: %q", text)
+	}
+	fm, body, ok := splitFrontmatter(text)
+	if !ok {
+		t.Fatalf("rendered file should round-trip through splitFrontmatter: %q", text)
+	}
+	if fm.Name != "redis-session-required" || fm.Description != "一句话摘要" {
+		t.Fatalf("frontmatter = %+v", fm)
