+// isSameOrUnderRelativePath classifies a filepath.Rel result without assuming
+// a POSIX separator. On Windows, sibling paths start with `..\`, not `../`.
+func isSameOrUnderRelativePath(rel string, separator rune) bool {
+	return rel == "." || (rel != ".." && !strings.HasPrefix(rel, ".."+string(separator)))
 }
 
