+
+// The summary content hash must be stable across rescans of an unchanged
+// skill directory, and must surface on the wire under the exact key the
+// Odoo report parser reads ("content_hash") without leaking file contents.
+func TestLocalSkills_ContentHash_StableAcrossRescans(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+
+	writeTestLocalSkill(t, filepath.Join(home, ".claude", "skills"), "brandkit", map[string]string{
+		"SKILL.md":        "---\nname: Brandkit\ndescription: 品牌套件\n---\n# Brandkit\n正文",
+		"refs/palette.md": "colors",
+	})
+
+	first, supported, err := listRuntimeLocalSkills("claude", nil)
+	if err != nil || !supported {
+		t.Fatalf("listRuntimeLocalSkills: supported=%v err=%v", supported, err)
+	}
+	if len(first) != 1 {
+		t.Fatalf("expected 1 skill, got %d", len(first))
+	}
+	hash := first[0].ContentHash
+	if !strings.HasPrefix(hash, "sha256:") {
+		t.Fatalf("content hash = %q, want a sha256:-prefixed digest", hash)
+	}
+
+	second, _, err := listRuntimeLocalSkills("claude", nil)
+	if err != nil {
+		t.Fatalf("rescan: %v", err)
+	}
+	if second[0].ContentHash != hash {
+		t.Fatalf("content hash changed across rescans of an unchanged dir: %q -> %q",
+			hash, second[0].ContentHash)
+	}
+
+	// Wire shape: the Odoo report parser reads "content_hash"; the summary
+	// still carries no file bodies.
+	raw, err := json.Marshal(first[0])
+	if err != nil {
+		t.Fatalf("marshal summary: %v", err)
+	}
+	var wire map[string]any
+	if err := json.Unmarshal(raw, &wire); err != nil {
+		t.Fatalf("unmarshal summary: %v", err)
+	}
+	if wire["content_hash"] != hash {
+		t.Fatalf("wire content_hash = %v, want %q", wire["content_hash"], hash)
+	}
+	if _, leaked := wire["files"]; leaked {
+		t.Fatal("summary must not carry file contents on the wire")
+	}
+}
+
+// The hash exists precisely because the file_count/description heuristic is
+// blind to body-only edits: same frontmatter (so same description), same
+// file set (so same file_count) — only bytes change. The hash must move in
+// every one of those cases.
+func TestLocalSkills_ContentHash_SensitiveToBodyOnlyChanges(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	skillDir := filepath.Join(home, ".claude", "skills", "brandkit")
+
+	frontmatter := "---\nname: Brandkit\ndescription: 品牌套件\n---\n"
+	writeTestLocalSkill(t, filepath.Dir(skillDir), "brandkit", map[string]string{
+		"SKILL.md":        frontmatter + "# Brandkit\nv1 正文",
+		"refs/palette.md": "colors-v1",
+	})
+	hashAt := func() string {
+		t.Helper()
+		skills, _, err := listRuntimeLocalSkills("claude", nil)
+		if err != nil {
+			t.Fatalf("listRuntimeLocalSkills: %v", err)
+		}
+		if len(skills) != 1 {
+			t.Fatalf("expected 1 skill, got %d", len(skills))
+		}
+		return skills[0].ContentHash
+	}
+
+	v1 := hashAt()
+
+	// SKILL.md body-only edit: identical frontmatter and file set.
+	if err := os.WriteFile(filepath.Join(skillDir, "SKILL.md"),
+		[]byte(frontmatter+"# Brandkit\nv2 正文改了"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if v2 := hashAt(); v2 == v1 {
+		t.Fatal("hash must change when only the SKILL.md body changes (the old file_count/description heuristic cannot see this)")
+	} else {
+		v1 = v2
+	}
+
+	// Supporting-file body-only edit: same path set, same file_count.
+	if err := os.WriteFile(filepath.Join(skillDir, "refs", "palette.md"),
+		[]byte("colors-v2"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if v3 := hashAt(); v3 == v1 {
+		t.Fatal("hash must change when a supporting file's content changes")
+	}
+}
