+// handleMemoryWrite pushes memories from the Odoo library down into the
+// runtime-local memory directories the server named, and reports what
+// actually happened per file. The write counterpart of handleMemoryScan.
+func (d *Daemon) handleMemoryWrite(ctx context.Context, rt Runtime, pending PendingMemoryWrite) {
+	d.logger.Info("runtime local memory write requested", "runtime_id", rt.ID, "request_id", pending.ID, "provider", rt.Provider, "targets", len(pending.Targets))
+
+	targets := make([]LocalMemoryWriteTarget, 0, len(pending.Targets))
+	for _, t := range pending.Targets {
+		writes := make([]LocalMemoryWriteItem, 0, len(t.Writes))
+		for _, w := range t.Writes {
+			writes = append(writes, LocalMemoryWriteItem{
+				Name: w.Name, File: w.File, Description: w.Description,
+				MemoryType: w.MemoryType, Content: w.Content,
+			})
+		}
+		targets = append(targets, LocalMemoryWriteTarget{
+			LocalDirectoryID: t.LocalDirectoryID,
+			Path:             t.Path,
+			Writes:           writes,
+			Deletes:          t.Deletes,
+		})
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		d.reportMemoryWriteResult(ctx, rt, pending.ID, map[string]any{
+			"status": "failed",
+			"error":  fmt.Sprintf("resolve home directory: %v", err),
+		})
+		return
+	}
+	results, _, err := writeRuntimeLocalMemories(rt.Provider, home, targets)
+	if err != nil {
+		d.reportMemoryWriteResult(ctx, rt, pending.ID, map[string]any{
+			"status": "failed",
+			"error":  err.Error(),
+		})
+		return
+	}
+	if results == nil {
+		results = []localMemoryWriteResult{}
+	}
+	d.reportMemoryWriteResult(ctx, rt, pending.ID, map[string]any{
+		"status":  "completed",
+		"results": results,
+	})
+}
+
+// reportMemoryWriteResult delivers a memory write/delete outcome to the
+// server with retry on transient failures.
+func (d *Daemon) reportMemoryWriteResult(ctx context.Context, rt Runtime, requestID string, payload map[string]any) {
+	d.reportRuntimeResultWithRetry(ctx, "memory_write", rt.ID, requestID, func(ctx context.Context) error {
+		return d.client.ReportMemoryWriteResult(ctx, rt.ID, requestID, payload)
+	})
+}
