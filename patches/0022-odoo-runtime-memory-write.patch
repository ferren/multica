+
+// DaemonHeartbeatPendingMemoryWrite describes a request to write/delete
+// runtime-local memory files across a set of local directories. ID is scoped
+// to the runtime (not unique per delivery) — the underlying operation is
+// idempotent, so the same ID being redelivered on consecutive heartbeats
+// before the daemon catches up is harmless.
+type DaemonHeartbeatPendingMemoryWrite struct {
+	ID      string                             `json:"id"`
+	Targets []DaemonHeartbeatMemoryWriteTarget `json:"targets"`
+}
+
+// DaemonHeartbeatMemoryWriteTarget is one local directory's write/delete
+// batch. LocalDirectoryID is opaque to the daemon and echoed back in the
+// report so the server can match results to its own records.
+type DaemonHeartbeatMemoryWriteTarget struct {
+	LocalDirectoryID string                           `json:"local_directory_id"`
+	Path             string                           `json:"path"`
+	Writes           []DaemonHeartbeatMemoryWriteItem `json:"writes,omitempty"`
+	Deletes          []string                         `json:"deletes,omitempty"`
+}
+
+// DaemonHeartbeatMemoryWriteItem is one memory file to write. Content is the
+// body only (no frontmatter) — the daemon generates the frontmatter itself so
+// every platform-managed file stays in the exact shape Claude Code expects.
+type DaemonHeartbeatMemoryWriteItem struct {
+	Name        string `json:"name"`
+	File        string `json:"file"`
+	Description string `json:"description,omitempty"`
+	MemoryType  string `json:"memory_type,omitempty"`
+	Content     string `json:"content"`
+}
