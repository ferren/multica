@@ -11,6 +11,23 @@ import (
 	"testing"
 )
 
+func TestRequireNativeBackend(t *testing.T) {
+	t.Run("native backend", func(t *testing.T) {
+		client := NewAPIClient("http://example.test", "", "")
+		if err := client.RequireNativeBackend("chat history"); err != nil {
+			t.Fatalf("native backend rejected: %v", err)
+		}
+	})
+
+	t.Run("odoo backend", func(t *testing.T) {
+		t.Setenv("MULTICA_BACKEND_MODE", "odoo")
+		client := NewAPIClient("http://example.test", "", "")
+		if err := client.RequireNativeBackend("chat history"); err == nil || !strings.Contains(err.Error(), "not supported with the Odoo backend") {
+			t.Fatalf("Odoo backend error = %v", err)
+		}
+	})
+}
