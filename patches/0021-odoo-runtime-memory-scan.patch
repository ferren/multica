--- /dev/null
+++ multica/server/internal/daemon/local_memory_test.go
@@ -0,0 +1,199 @@
+package daemon
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func writeMemoryFile(t *testing.T, dir, name, body string) {
+	t.Helper()
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestClaudeProjectSlug(t *testing.T) {
+	// The slug is the working directory with separators turned into dashes —
+	// the leading dash comes from the leading slash.
+	if got := claudeProjectSlug("/home/ferren/projects/odoo-proj"); got != "-home-ferren-projects-odoo-proj" {
+		t.Fatalf("slug = %q", got)
+	}
+	// Trailing separators are cleaned first so the same directory always maps
+	// to the same slug.
+	if got := claudeProjectSlug("/home/ferren/projects/odoo-proj/"); got != "-home-ferren-projects-odoo-proj" {
+		t.Fatalf("slug with trailing slash = %q", got)
+	}
+	if got := claudeProjectSlug(""); got != "" {
+		t.Fatalf("empty path slug = %q", got)
+	}
+}
+
+func TestClaudeMemoryDir(t *testing.T) {
+	got := claudeMemoryDir("/home/ferren", "/home/ferren/projects/odoo-proj")
+	want := "/home/ferren/.claude/projects/-home-ferren-projects-odoo-proj/memory"
+	if got != want {
+		t.Fatalf("memory dir = %q, want %q", got, want)
+	}
+	if got := claudeMemoryDir("", "/x"); got != "" {
+		t.Fatalf("no home should yield empty dir, got %q", got)
+	}
+}
+
+func TestProviderSupportsLocalMemory(t *testing.T) {
+	for _, p := range []string{"claude", "Claude", " claude "} {
+		if !providerSupportsLocalMemory(p) {
+			t.Fatalf("provider %q should be supported", p)
+		}
+	}
+	// Guessing a path for a runtime without a known memory layout would
+	// produce a confidently wrong inventory — those must report unsupported.
+	for _, p := range []string{"codex", "qwen", "opencode", ""} {
+		if providerSupportsLocalMemory(p) {
+			t.Fatalf("provider %q must not be supported", p)
+		}
+	}
+}
+
+func TestParseLocalMemoryFileFrontmatter(t *testing.T) {
+	dir := t.TempDir()
+	writeMemoryFile(t, dir, "communicate-in-chinese.md",
+		"---\nname: communicate-in-chinese\ndescription: 用户要求所有沟通一律用中文回复\nmetadata: \n  node_type: memory\n  type: feedback\n---\n\n所有沟通一律用中文。\n")
+	info, err := os.Stat(filepath.Join(dir, "communicate-in-chinese.md"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	entry := parseLocalMemoryFile(dir, "communicate-in-chinese.md", info)
+	if entry.Name != "communicate-in-chinese" || entry.MemoryType != "feedback" {
+		t.Fatalf("got name=%q type=%q", entry.Name, entry.MemoryType)
+	}
+	if entry.Description != "用户要求所有沟通一律用中文回复" {
+		t.Fatalf("description = %q", entry.Description)
+	}
+	if entry.Content != "所有沟通一律用中文。" {
+		t.Fatalf("content = %q", entry.Content)
+	}
+	if !strings.HasPrefix(entry.ContentHash, "sha256:") {
+		t.Fatalf("content hash = %q", entry.ContentHash)
+	}
+	if entry.SizeBytes != info.Size() || entry.ModifiedAt == "" {
+		t.Fatalf("size/mtime not reported: %+v", entry)
+	}
+}
+
+func TestParseLocalMemoryFileWithoutFrontmatter(t *testing.T) {
+	// A file with no frontmatter still exists on disk and the operator needs
+	// to see it; only the parsed fields stay empty.
+	dir := t.TempDir()
+	writeMemoryFile(t, dir, "loose-note.md", "just a note\n")
+	info, _ := os.Stat(filepath.Join(dir, "loose-note.md"))
+	entry := parseLocalMemoryFile(dir, "loose-note.md", info)
+	if entry.Name != "loose-note" {
+		t.Fatalf("name = %q, want the filename stem", entry.Name)
+	}
+	if entry.Description != "" || entry.MemoryType != "" {
+		t.Fatalf("unparsed file should not invent metadata: %+v", entry)
+	}
+	if entry.Content != "just a note" {
+		t.Fatalf("content = %q", entry.Content)
+	}
+}
+
+func TestParseLocalMemoryFileTruncatesLongBody(t *testing.T) {
+	dir := t.TempDir()
+	long := strings.Repeat("长", memoryContentReportMax+500)
+	writeMemoryFile(t, dir, "huge.md", "---\nname: huge\ndescription: d\n---\n"+long)
+	info, _ := os.Stat(filepath.Join(dir, "huge.md"))
+	entry := parseLocalMemoryFile(dir, "huge.md", info)
+	if !entry.Truncated {
+		t.Fatal("oversized body must be flagged truncated")
+	}
+	if n := len([]rune(entry.Content)); n > memoryContentReportMax {
+		t.Fatalf("content kept %d runes, over the %d cap", n, memoryContentReportMax)
+	}
+	// The hash covers the whole file even when the content is cut, so drift
+	// against the library is still detectable.
+	if entry.ContentHash == "" {
+		t.Fatal("hash must cover the full file")
+	}
+}
+
+func TestScanLocalMemoryDirSkipsIndexAndSorts(t *testing.T) {
+	dir := t.TempDir()
+	writeMemoryFile(t, dir, "MEMORY.md", "- [x](x.md) — index\n")
+	writeMemoryFile(t, dir, "b-fact.md", "---\nname: b-fact\ndescription: b\n---\nbody b\n")
+	writeMemoryFile(t, dir, "a-fact.md", "---\nname: a-fact\ndescription: a\n---\nbody a\n")
+	writeMemoryFile(t, dir, "notes.txt", "ignored")
+
+	memories, exists, err := scanLocalMemoryDir(dir)
+	if err != nil || !exists {
+		t.Fatalf("scan: err=%v exists=%v", err, exists)
+	}
+	if len(memories) != 2 {
+		t.Fatalf("got %d memories, want 2: %+v", len(memories), memories)
+	}
+	if memories[0].Name != "a-fact" || memories[1].Name != "b-fact" {
+		t.Fatalf("memories not sorted by name: %+v", memories)
+	}
+}
+
+func TestScanLocalMemoryDirMissingIsNotAnError(t *testing.T) {
+	// "this project has no memories yet" is a valid inventory answer.
+	memories, exists, err := scanLocalMemoryDir(filepath.Join(t.TempDir(), "nope"))
+	if err != nil {
+		t.Fatalf("missing dir should not error: %v", err)
+	}
+	if exists || len(memories) != 0 {
+		t.Fatalf("exists=%v memories=%+v", exists, memories)
+	}
+}
+
+func TestScanRuntimeLocalMemoriesUnsupportedProvider(t *testing.T) {
+	results, supported, err := scanRuntimeLocalMemories("codex", "/home/x", []LocalMemoryScanTarget{{Path: "/srv/app"}})
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if supported {
+		t.Fatal("codex must report unsupported")
+	}
+	if results != nil {
+		t.Fatalf("unsupported provider must not report results: %+v", results)
+	}
+}
+
+func TestScanRuntimeLocalMemoriesPerTarget(t *testing.T) {
+	home := t.TempDir()
+	projectPath := "/srv/app"
+	memDir := claudeMemoryDir(home, projectPath)
+	writeMemoryFile(t, memDir, "a-fact.md", "---\nname: a-fact\ndescription: a\nmetadata:\n  type: project\n---\nbody a\n")
+
+	results, supported, err := scanRuntimeLocalMemories("claude", home, []LocalMemoryScanTarget{
+		{LocalDirectoryID: "14", Path: projectPath},
+		{LocalDirectoryID: "15", Path: "/srv/never-used"},
+		{LocalDirectoryID: "16", Path: "  "},
+	})
+	if err != nil || !supported {
+		t.Fatalf("scan: err=%v supported=%v", err, supported)
+	}
+	if len(results) != 3 {
+		t.Fatalf("got %d results, want one per target", len(results))
+	}
+	if results[0].LocalDirectoryID != "14" || !results[0].Exists || len(results[0].Memories) != 1 {
+		t.Fatalf("first target: %+v", results[0])
+	}
+	if results[0].Memories[0].Name != "a-fact" || results[0].Memories[0].MemoryType != "project" {
+		t.Fatalf("entry: %+v", results[0].Memories[0])
+	}
+	// A directory that never ran Claude Code reports exists=false with no
+	// memories — distinct from "scan failed".
+	if results[1].Exists || len(results[1].Memories) != 0 || results[1].Error != "" {
+		t.Fatalf("second target: %+v", results[1])
+	}
+	if results[2].Error == "" {
+		t.Fatalf("blank path should be reported as an error: %+v", results[2])
+	}
+}
