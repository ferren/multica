Index: multica/server/internal/daemon/local_memory.go
===================================================================
--- /dev/null
+++ multica/server/internal/daemon/local_memory.go
@@ -0,0 +1,222 @@
+package daemon
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"gopkg.in/yaml.v3"
+)
+
+// Runtime-local memories: the per-project memory files a runtime keeps on the
+// daemon host, outside anything the platform writes. Claude Code stores them
+// under ~/.claude/projects/<slug>/memory/, keyed by the working directory —
+// which for a local_directory task IS the project's local path, so the server
+// can ask "what memories exist for this local directory" and get a real answer.
+//
+// This file only READS. The scan feeds the Odoo-side inventory
+// (inair.multica.memory.instance); writing/deleting is a separate command.
+
+// memoryFileMaxBytes caps how much of a single memory file is read back to the
+// server. Memory files are prose; anything past this is a runaway log and the
+// content is truncated (the hash still covers the full file so drift is
+// detectable).
+const memoryFileMaxBytes = 64 * 1024
+
+// memoryContentReportMax caps the content actually shipped in the report, so a
+// directory full of large files cannot blow up a single HTTP body.
+const memoryContentReportMax = 20000
+
+// LocalMemoryScanTarget is one local directory to inspect, as sent by the
+// server. LocalDirectoryID is opaque to the daemon and echoed back so the
+// server can match results to its own records.
+type LocalMemoryScanTarget struct {
+	LocalDirectoryID string `json:"local_directory_id"`
+	Path             string `json:"path"`
+}
+
+// localMemoryEntry is one memory file found on disk.
+type localMemoryEntry struct {
+	Name        string `json:"name"`
+	Description string `json:"description,omitempty"`
+	MemoryType  string `json:"memory_type,omitempty"`
+	File        string `json:"file"`
+	Content     string `json:"content,omitempty"`
+	Truncated   bool   `json:"truncated,omitempty"`
+	SizeBytes   int64  `json:"size_bytes"`
+	ModifiedAt  string `json:"modified_at,omitempty"`
+	ContentHash string `json:"content_hash,omitempty"`
+}
+
+// localMemoryScanResult is the per-target result.
+type localMemoryScanResult struct {
+	LocalDirectoryID string             `json:"local_directory_id"`
+	Path             string             `json:"path"`
+	MemoryDir        string             `json:"memory_dir,omitempty"`
+	Exists           bool               `json:"exists"`
+	Memories         []localMemoryEntry `json:"memories"`
+	Error            string             `json:"error,omitempty"`
+}
+
+// localMemoryFrontmatter is the frontmatter Claude Code writes on each memory
+// file. Unknown keys are ignored.
+type localMemoryFrontmatter struct {
+	Name        string `yaml:"name"`
+	Description string `yaml:"description"`
+	Metadata    struct {
+		Type string `yaml:"type"`
+	} `yaml:"metadata"`
+}
+
+// providerSupportsLocalMemory reports whether this runtime provider keeps
+// per-project memory files the daemon knows how to locate. Only Claude Code
+// for now — codex/qwen/cursor have no equivalent per-project memory store, and
+// guessing a path for them would produce confidently wrong inventories.
+func providerSupportsLocalMemory(provider string) bool {
+	return strings.EqualFold(strings.TrimSpace(provider), "claude")
+}
+
+// claudeProjectSlug maps an absolute working directory to the directory name
+// Claude Code uses under ~/.claude/projects: every path separator becomes a
+// dash, so "/home/ferren/projects/odoo-proj" becomes
+// "-home-ferren-projects-odoo-proj" (leading dash included, from the leading
+// slash). The mapping is lossy in reverse (a path segment containing "-" is
+// indistinguishable) but we only ever need the forward direction.
+func claudeProjectSlug(path string) string {
+	if strings.TrimSpace(path) == "" {
+		return ""
+	}
+	// filepath.Clean("") is ".", which would silently become a slug — guard
+	// the blank case above rather than letting it through.
+	return strings.ReplaceAll(filepath.Clean(path), string(filepath.Separator), "-")
+}
+
+// claudeMemoryDir returns the per-project memory directory for a working
+// directory, or "" when the home directory cannot be resolved.
+func claudeMemoryDir(home, path string) string {
+	slug := claudeProjectSlug(path)
+	if home == "" || slug == "" {
+		return ""
+	}
+	return filepath.Join(home, ".claude", "projects", slug, "memory")
+}
+
+// parseLocalMemoryFile turns one *.md file into an entry. Files without
+// frontmatter still count — they exist on disk and the operator needs to see
+// them; only name/description/type stay empty.
+func parseLocalMemoryFile(dir, fileName string, info os.FileInfo) localMemoryEntry {
+	entry := localMemoryEntry{
+		Name:       strings.TrimSuffix(fileName, ".md"),
+		File:       fileName,
+		SizeBytes:  info.Size(),
+		ModifiedAt: info.ModTime().UTC().Format(time.RFC3339),
+	}
+	raw, err := os.ReadFile(filepath.Join(dir, fileName))
+	if err != nil {
+		return entry
+	}
+	sum := sha256.Sum256(raw)
+	entry.ContentHash = "sha256:" + hex.EncodeToString(sum[:])
+	if len(raw) > memoryFileMaxBytes {
+		raw = raw[:memoryFileMaxBytes]
+		entry.Truncated = true
+	}
+	text := strings.ReplaceAll(string(raw), "\r\n", "\n")
+
+	body := text
+	if strings.HasPrefix(text, "---\n") {
+		rest := text[len("---\n"):]
+		if end := strings.Index(rest, "\n---"); end >= 0 {
+			var fm localMemoryFrontmatter
+			if yaml.Unmarshal([]byte(rest[:end+1]), &fm) == nil {
+				if name := strings.TrimSpace(fm.Name); name != "" {
+					entry.Name = name
+				}
+				entry.Description = strings.TrimSpace(fm.Description)
+				entry.MemoryType = strings.TrimSpace(fm.Metadata.Type)
+			}
+			body = strings.TrimPrefix(rest[end+len("\n---"):], "\n")
+		}
+	}
+	body = strings.TrimSpace(body)
+	if utf8.RuneCountInString(body) > memoryContentReportMax {
+		body = string([]rune(body)[:memoryContentReportMax])
+		entry.Truncated = true
+	}
+	entry.Content = body
+	return entry
+}
+
+// scanLocalMemoryDir lists the memory files in one directory. A missing
+// directory is not an error: "this project has no memories yet" is a valid,
+// useful answer for the inventory.
+func scanLocalMemoryDir(dir string) ([]localMemoryEntry, bool, error) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil, false, nil
+		}
+		return nil, false, err
+	}
+	memories := make([]localMemoryEntry, 0, len(entries))
+	for _, e := range entries {
+		// MEMORY.md is the runtime's own index of the other files, not a
+		// memory; recreating it is the runtime's job, not the platform's.
+		if e.IsDir() || !strings.HasSuffix(e.Name(), ".md") || e.Name() == "MEMORY.md" {
+			continue
+		}
+		info, err := e.Info()
+		if err != nil {
+			continue
+		}
+		memories = append(memories, parseLocalMemoryFile(dir, e.Name(), info))
+	}
+	sort.Slice(memories, func(i, j int) bool { return memories[i].Name < memories[j].Name })
+	return memories, true, nil
+}
+
+// scanRuntimeLocalMemories inspects every requested local directory for the
+// given provider. The bool reports whether this provider has a known memory
+// layout at all — false means "we did not look", which the server must not
+// confuse with "there is nothing there".
+func scanRuntimeLocalMemories(provider, home string, targets []LocalMemoryScanTarget) ([]localMemoryScanResult, bool, error) {
+	if !providerSupportsLocalMemory(provider) {
+		return nil, false, nil
+	}
+	if home == "" {
+		return nil, true, fmt.Errorf("cannot resolve home directory for provider %q", provider)
+	}
+	results := make([]localMemoryScanResult, 0, len(targets))
+	for _, target := range targets {
+		path := strings.TrimSpace(target.Path)
+		result := localMemoryScanResult{
+			LocalDirectoryID: target.LocalDirectoryID,
+			Path:             path,
+			Memories:         []localMemoryEntry{},
+		}
+		if path == "" {
+			result.Error = "empty path"
+			results = append(results, result)
+			continue
+		}
+		dir := claudeMemoryDir(home, path)
+		result.MemoryDir = dir
+		memories, exists, err := scanLocalMemoryDir(dir)
+		if err != nil {
+			result.Error = err.Error()
+		} else {
+			result.Exists = exists
+			if memories != nil {
+				result.Memories = memories
+			}
+		}
+		results = append(results, result)
+	}
+	return results, true, nil
+}
Index: multica/server/internal/daemon/local_memory_test.go
