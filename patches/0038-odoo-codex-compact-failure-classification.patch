+func TestCodexContextCompactTypedCapacityContinuesOriginalThread(t *testing.T) {
+	t.Parallel()
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX fixture")
+	}
+	failedTurn := strings.ReplaceAll(fakeCodexCompactStartTurnAndServeFailure("turn-1"),
+		codexContextCapacityMessageMarker, "capacity reached")
+	fakePath := writeFakeCodexAppServer(t, fakeCodexCompactPreamble+`
+if [ "$INV" = "1" ]; then
+`+failedTurn+fakeCodexCompactAcceptAndComplete+`
+  read line
+else
+`+fakeCodexCompactSucceedingTurn+`
+fi
+`)
+	result := executeFakeCodex(t, fakePath, fakeCodexCompactOptions())
+	if result.Status != "completed" || result.SessionID != "thr_prior" {
+		t.Fatalf("typed capacity error must recover without matching prose: %+v", result)
+	}
+	if n := fakeCodexInvocations(t, filepath.Dir(fakePath)); n != 2 {
+		t.Fatalf("expected one continuation, got %d launches", n)
+	}
+}
