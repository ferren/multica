 // overwrite user bytes (the bug PR #3444 review caught) or skip the
 // skill entirely (which would silently drop a Multica skill the agent
 // expects to see).
+// skipLocallyPresentSkills returns skills minus those whose SourcePath resolves
+// to an existing directory on this machine.
+//
+// The Odoo backend attaches SourcePath (the home-relative path the daemon
+// reported when it first scanned the skill from a local root) to skills that
+// were imported from this runtime's own ~/.claude/skills (or equivalent). When
+// such a skill is shipped back on claim, materializing it into the workdir's
+// skills directory would duplicate the user's local copy — and the provider
+// (Claude Code discovers both ~/.claude/skills and the workdir) already finds
+// the local one. Skipping the rewrite avoids the duplicate and the wasted IO.
+//
+// A skill is only skipped when its SourcePath is non-empty AND resolves to an
+// existing directory; anything else (empty path, deleted local copy, IO error)
+// falls through to normal materialization so the agent never loses a skill.
+func skipLocallyPresentSkills(skills []SkillContextForEnv) []SkillContextForEnv {
+	if len(skills) == 0 {
+		return skills
+	}
+	kept := make([]SkillContextForEnv, 0, len(skills))
+	skipped := 0
+	for _, s := range skills {
+		if s.SourcePath != "" && dirExists(expandHome(s.SourcePath)) {
+			skipped++
+			continue
+		}
+		kept = append(kept, s)
+	}
+	if skipped > 0 {
+		slog.Debug("skipped locally-present skills during materialization",
+			"skipped", skipped, "kept", len(kept))
+	}
+	return kept
+}
+
+// expandHome expands a leading ~ or ~/ to the user's home directory, mirroring
+// the inverse of daemon.relativizeHomePath (which is how source_path was
+// produced). Non-tilde paths are returned unchanged.
+func expandHome(p string) string {
+	if p == "~" {
+		if home, err := os.UserHomeDir(); err == nil {
+			return home
+		}
+		return p
+	}
+	if strings.HasPrefix(p, "~/") || strings.HasPrefix(p, "~\\") {
+		if home, err := os.UserHomeDir(); err == nil {
+			return filepath.Join(home, p[2:])
+		}
+	}
+	return p
+}
+
+func dirExists(p string) bool {
+	info, err := os.Stat(p)
+	return err == nil && info.IsDir()
+}
