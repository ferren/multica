+func TestOdooSkillBaseRevisionRejectsUnsupportedPrecondition(t *testing.T) {
+	cmd := &cobra.Command{}
+	cmd.Flags().Int64("base-revision", 0, "")
+	if _, hasBase, err := skillBaseRevision(cmd, true); err != nil || hasBase {
+		t.Fatalf("legacy Odoo skill write should work without the flag: %v", err)
+	}
+	if err := cmd.Flags().Set("base-revision", "7"); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := skillBaseRevision(cmd, true); err == nil || !strings.Contains(err.Error(), "does not provide") {
+		t.Fatalf("unsupported precondition should fail before writing: %v", err)
+	}
+	if base, hasBase, err := skillBaseRevision(cmd, false); err != nil || !hasBase || base != 7 {
+		t.Fatalf("native precondition = %d, present=%v, err=%v", base, hasBase, err)
+	}
+}
