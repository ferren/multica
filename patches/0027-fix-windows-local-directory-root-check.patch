+func TestIsSameOrUnderRelativePath(t *testing.T) {
+	cases := []struct {
+		name      string
+		rel       string
+		separator rune
+		want      bool
+	}{
+		{"equal", ".", '/', true},
+		{"POSIX nested", "project/child", '/', true},
+		{"POSIX direct parent", "..", '/', false},
+		{"POSIX sibling", "../project", '/', false},
+		{"Windows nested", `project\child`, '\\', true},
+		{"Windows direct parent", "..", '\\', false},
+		{"Windows sibling", `..\Projects\QCC\syner-es-8`, '\\', false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := isSameOrUnderRelativePath(tc.rel, tc.separator); got != tc.want {
+				t.Errorf("isSameOrUnderRelativePath(%q, %q) = %v, want %v", tc.rel, tc.separator, got, tc.want)
+			}
+		})
+	}
+}
