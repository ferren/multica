Index: multica/server/internal/cli/task_credentials.go
===================================================================
--- /dev/null
+++ multica/server/internal/cli/task_credentials.go
@@ -0,0 +1,67 @@
+package cli
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+const TaskCredentialFileEnv = "MULTICA_TASK_CREDENTIAL_FILE"
+
+// OdooTaskCredential is one indivisible token pair for a single execution.
+// No caller may combine a token read from this file with an environment key.
+type OdooTaskCredential struct {
+	AccessToken string    `json:"access_token"`
+	APIKey      string    `json:"api_key"`
+	ServerURL   string    `json:"server_url"`
+	TaskID      string    `json:"task_id"`
+	AgentID     string    `json:"agent_id"`
+	ExpiresAt   time.Time `json:"expires_at"`
+}
+
+func WriteTaskCredential(path string, credential OdooTaskCredential) error {
+	data, err := json.Marshal(credential)
+	if err != nil {
+		return fmt.Errorf("encode task credential")
+	}
+	file, err := os.CreateTemp(filepath.Dir(path), ".credential-*")
+	if err != nil {
+		return fmt.Errorf("create task credential snapshot")
+	}
+	defer os.Remove(file.Name())
+	if _, err = file.Write(data); err != nil {
+		file.Close()
+		return fmt.Errorf("write task credential snapshot")
+	}
+	if err = file.Close(); err != nil {
+		return fmt.Errorf("close task credential snapshot")
+	}
+	// Same-directory replacement preserves the previous complete pair on failure.
+	if err = replaceTaskCredential(file.Name(), path); err != nil {
+		return fmt.Errorf("publish task credential snapshot")
+	}
+	return nil
+}
+
+func readTaskCredential(path, serverURL, taskID, agentID string) (OdooTaskCredential, error) {
+	var credential OdooTaskCredential
+	if !filepath.IsAbs(path) {
+		return credential, fmt.Errorf("task credential path must be absolute")
+	}
+	data, err := readTaskCredentialSnapshot(path)
+	if err != nil {
+		return credential, fmt.Errorf("task credential unavailable; runtime must supply a valid credential")
+	}
+	if json.Unmarshal(data, &credential) != nil || credential.AccessToken == "" || credential.APIKey == "" ||
+		taskID == "" || agentID == "" || credential.TaskID != taskID || credential.AgentID != agentID ||
+		strings.TrimRight(credential.ServerURL, "/") != strings.TrimRight(serverURL, "/") {
+		return OdooTaskCredential{}, fmt.Errorf("task credential does not match this execution")
+	}
+	if !time.Now().Before(credential.ExpiresAt) {
+		return OdooTaskCredential{}, fmt.Errorf("task credential expired; runtime must renew it")
+	}
+	return credential, nil
+}
