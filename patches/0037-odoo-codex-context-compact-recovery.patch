+// codexContextCapacityInfoValue is the wire value of the typed
+// CodexErrorInfo::ContextWindowExceeded variant (codex-protocol error.rs,
+// snake_case on the wire). Codex 0.166 ships it on both terminal `error`
+// notifications and turn/completed's turn.error.codexErrorInfo.
+const codexContextCapacityInfoValue = "context_window_exceeded"
+
+// codexContextCapacityMessageMarker is the distinctive fixed prose of the
+// same failure when only the message string is available (older Codex, or a
+// custom runtime speaking the protocol without the typed field):
+//
+//	"Codex ran out of room in the model's context window. Start a new thread
+//	 or clear earlier history before retrying."
+//
+// Only the first clause is matched, and it is matched as a whole phrase: it
+// names the exact condition compaction cures, and nothing else in Codex's
+// error surface says it. Provider-raw 400 bodies are deliberately NOT
+// matched — "context length" style text appears in failures compaction
+// cannot cure (a single oversized input among them), and the Anthropic
+// invalid_request branch in internal/daemon already owns that shape.
+const codexContextCapacityMessageMarker = "ran out of room in the model's context window"
+
+// codexContextCapacityFailure reports whether a failed turn's typed error
+// info or message text identifies the context-window capacity failure — the
+// one class a thread/compact/start can cure while keeping the thread. Rate
+// limits, usage limits and session budgets stay out on purpose: compaction
+// shrinks history, it does not refill quota.
+func codexContextCapacityFailure(info, message string) bool {
+	if strings.EqualFold(strings.TrimSpace(info), codexContextCapacityInfoValue) {
+		return true
+	}
+	return strings.Contains(strings.ToLower(message), codexContextCapacityMessageMarker)
+}
+
+// The three compaction diagnostics below are appended to the surfaced error
+// text, which is persisted in agent_task_queue.error and re-scanned by the
+// resume guards (CodexResumeOverflowError, CodexRetiredCompactionError) and
+// taskfailure.Classify indefinitely. Like codexRetiredCompactionHint in
+// internal/daemon, the CONSTANT parts are worded to stay clear of every phrase
+// those match; only the provider-owned detail is variable, and a detail that
+// genuinely carries the retired-route markers is supposed to — the daemon's
+// annotation then appends the config-fix hint on top, which is the desired
+// pairing. TestCodexCompactDiagnosticsCannotChangeMachineDecisions pins the
+// constant parts against those classifiers.
+func codexCompactRefusedDiagnostic(detail string) string {
+	msg := " [multica] codex could not start compacting this conversation"
+	if d := strings.TrimSpace(detail); d != "" {
+		msg += ": " + d
+	}
+	return msg + ". The conversation is kept; this run may continue on a fresh session and the thread recovers once codex compaction is available again."
+}
+
+func codexCompactTimedOutDiagnostic(detail string, waited time.Duration) string {
+	msg := fmt.Sprintf(" [multica] codex did not finish compacting this conversation within %s", waited.Round(time.Second).String())
+	if d := strings.TrimSpace(detail); d != "" {
+		msg += ": " + d
+	}
+	return msg + ". The conversation is kept; the next run retries compaction."
+}
+
+func codexCompactFailedDiagnostic(detail string) string {
+	msg := " [multica] codex compacted this conversation and the compaction itself failed"
+	if d := strings.TrimSpace(detail); d != "" {
+		msg += ": " + d
+	}
+	return msg + ". The thread stays over the context limit with no remaining cure, so the session is dropped and the next run starts fresh."
+}
