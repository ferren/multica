+//go:build odoointegration
+
+package daemon
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httputil"
+	"net/url"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+)
+
+// This opt-in suite uses the real Odoo HTTP/gevent workers and the production
+// daemon wakeup, poller, StartTask and completion paths. Only the paid agent
+// execution is replaced. tests/daemon_ws_e2e.py owns the isolated fixture server.
+func TestOdooWebsocketIntegration(t *testing.T) {
+	helperURL := os.Getenv("MULTICA_ODOO_WS_E2E")
+	if helperURL == "" {
+		t.Skip("requires isolated daemon_ws_e2e.py environment")
+	}
+	fixtureCall := func(action string, body map[string]any, result any) {
+		t.Helper()
+		if body == nil {
+			body = map[string]any{}
+		}
+		payload, _ := json.Marshal(body)
+		resp, err := http.Post(helperURL+"/"+action, "application/json", bytes.NewReader(payload))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode != 200 {
+			t.Fatalf("fixture %s returned %d", action, resp.StatusCode)
+		}
+		if result != nil {
+			if err := json.NewDecoder(resp.Body).Decode(result); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	type fixture struct {
+		AppID     string `json:"app_id"`
+		AppSecret string `json:"app_secret"`
+		DaemonID  string `json:"daemon_id"`
+		RuntimeID string `json:"runtime_id"`
+		DB        string `json:"db"`
+		HTTPURL   string `json:"http_url"`
+		WSURL     string `json:"ws_url"`
+	}
+	var f [2]fixture
+	for i := range f {
+		fixtureCall("fixture", map[string]any{"index": i}, &f[i])
+	}
+	httpTarget, _ := url.Parse(f[0].HTTPURL)
+	wsTarget, _ := url.Parse(f[0].WSURL)
+	var mu sync.Mutex
+	var wsConnections []net.Conn
+	var claimTimes []time.Time
+	transport := &http.Transport{DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+		conn, err := (&net.Dialer{}).DialContext(ctx, network, address)
+		if err == nil && address == wsTarget.Host {
+			mu.Lock()
+			wsConnections = append(wsConnections, conn)
+			mu.Unlock()
+		}
+		return conn, err
+	}}
+	defer transport.CloseIdleConnections()
+	proxy := &httputil.ReverseProxy{Transport: transport, Director: func(r *http.Request) {
+		target := httpTarget
+		if r.URL.Path == "/multica/daemon/ws" {
+			target = wsTarget
+			if r.Header.Get("Cookie") != "" {
+				t.Error("daemon handshake sent a browser cookie")
+			}
+		}
+		if r.URL.Path == "/multica/daemon/tasks/claim" {
+			mu.Lock()
+			claimTimes = append(claimTimes, time.Now())
+			mu.Unlock()
+		}
+		r.URL.Scheme, r.URL.Host = target.Scheme, target.Host
+		r.Host = target.Host
+	}, ErrorLog: nil}
+	server := httptest.NewServer(proxy)
+	defer server.Close()
+	newDaemon := func(index int, pollInterval time.Duration) *Daemon {
+		d := New(Config{BackendMode: "odoo", ServerBaseURL: server.URL,
+			DBName: f[index].DB, DaemonID: f[index].DaemonID,
+			WorkspacesRoot: t.TempDir(), MaxConcurrentTasks: 2,
+			PollInterval: pollInterval}, slog.New(slog.NewTextHandler(io.Discard, nil)))
+		if err := d.client.FetchOdooToken(context.Background(), f[index].AppID, f[index].AppSecret, f[index].DB); err != nil {
+			t.Fatal(err)
+		}
+		d.oursRuntimeIDs[f[index].RuntimeID] = true
+		d.runtimeIndex[f[index].RuntimeID] = Runtime{ID: f[index].RuntimeID, Provider: "codex"}
+		d.client.SetOnTokenError(func() {
+			if err := d.client.FetchOdooToken(context.Background(), f[index].AppID, f[index].AppSecret, f[index].DB); err != nil {
+				t.Errorf("token refresh failed: %v", err)
+			}
+		})
+		return d
+	}
+	d := newDaemon(0, time.Hour)
+	if _, err := d.ClaimTasksWSFirst(context.Background(), f[0].DaemonID, []string{f[0].RuntimeID}, 1); err != nil {
+		t.Fatalf("no-session REST authentication failed: %v", err)
+	}
+	starts := make(chan Task, 32)
+	var executionMu sync.Mutex
+	executions := map[string]int{}
+	installRunner := func(target *Daemon) {
+		target.runner = taskRunnerFunc(func(ctx context.Context, task Task, _ string, _ int, _ *slog.Logger) (TaskResult, error) {
+			if _, err := target.client.StartTask(ctx, task); err != nil {
+				return TaskResult{}, err
+			}
+			executionMu.Lock()
+			executions[task.ID]++
+			executionMu.Unlock()
+			starts <- task
+			return TaskResult{Status: "completed"}, nil
+		})
+	}
+	installRunner(d)
+	ctx, cancel := context.WithCancel(context.Background())
+	wakeups, forwarded := make(chan taskWakeup, 256), make(chan taskWakeup, 256)
+	hints := make(chan time.Time, 256)
+	wsDone, pollDone, tapDone := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() { defer close(wsDone); d.odooTaskWakeupLoop(ctx, wakeups) }()
+	go func() { defer close(pollDone); d.pollLoop(ctx, forwarded) }()
+	go func() {
+		defer close(tapDone)
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case hint := <-wakeups:
+				hints <- time.Now()
+				forwarded <- hint
+			}
+		}
+	}()
+	defer func() { cancel(); <-wsDone; <-pollDone; <-tapDone }()
+	waitHint := func() time.Time {
+		t.Helper()
+		select {
+		case at := <-hints:
+			return at
+		case <-time.After(10 * time.Second):
+			t.Fatal("no ready/task hint from Odoo")
+			return time.Time{}
+		}
+	}
+	drainHints := func() {
+		for {
+			select {
+			case <-hints:
+			default:
+				return
+			}
+		}
+	}
+	enqueue := func(index int) (string, time.Time) {
+		var result struct {
+			TaskID      string  `json:"task_id"`
