+// TestReportTaskResult_ShutdownLeavesCancelledRunForRecoverOrphans pins issue #157:
+// when the daemon is shutting down (parent ctx cancelled) and a run surfaces as
+// Status=="cancelled" — the abort a graceful `multica daemon stop` induces —
+// reportTaskResult must NOT report it. Leaving the task in place lets the next
+// daemon start's recover-orphans pass resume it with its pinned session, instead
+// of failing it (which would force a re-dispatch and lose the session). A genuine
+// failure status is still reported even on shutdown (see ...StillReportsTerminalState/fail).
+func TestReportTaskResult_ShutdownLeavesCancelledRunForRecoverOrphans(t *testing.T) {
+	t.Parallel()
+
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		calls.Add(1)
+		w.WriteHeader(http.StatusOK)
+	}))
+	t.Cleanup(srv.Close)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	d := &Daemon{client: NewClient(srv.URL), logger: slog.Default()}
+	d.reportTaskResult(ctx, "task-shutdown-cancel", TaskResult{
+		Status:    "cancelled",
+		Comment:   "task cancelled by server",
+		SessionID: "ses-resume",
+	}, slog.Default())
+
+	if got := calls.Load(); got != 0 {
+		t.Fatalf("terminal callback calls = %d, want 0 (shutdown-cancelled run left for recover-orphans)", got)
+	}
+}
