+)
+
+func pluginOdooTestCmd() *cobra.Command {
+	cmd := &cobra.Command{}
+	cmd.SetOut(&bytes.Buffer{})
+	cmd.Flags().String("workspace-id", "", "")
+	cmd.Flags().String("profile", "", "")
+	cmd.Flags().String("server-url", "", "")
+	cmd.Flags().String("output", "json", "")
+	return cmd
+}
+
+func pluginOdooTestServer(t *testing.T, handler http.HandlerFunc) {
+	t.Helper()
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv("MULTICA_TOKEN", "test-token")
+	t.Setenv("MULTICA_WORKSPACE_ID", testWorkspaceMcpID)
+	srv := httptest.NewServer(handler)
+	t.Cleanup(srv.Close)
+	t.Setenv("MULTICA_SERVER_URL", srv.URL)
+}
+
+func TestRunPluginListUsesOdooBackendRoute(t *testing.T) {
+	var gotPath string
+	pluginOdooTestServer(t, func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{"plugins": []map[string]any{}})
+	})
+	t.Setenv("MULTICA_BACKEND_MODE", "odoo")
+
+	cmd := pluginOdooTestCmd()
+	if _, err := captureStdout(t, func() error { return runPluginList(cmd, nil) }); err != nil {
+		t.Fatalf("runPluginList: %v", err)
+	}
+	want := "/multica/agent/workspaces/" + testWorkspaceMcpID + "/plugins/private"
+	if gotPath != want {
+		t.Fatalf("path = %q, want %q", gotPath, want)
+	}
+}
+
+func TestRunPluginStatusUsesOdooBackendRoute(t *testing.T) {
+	const pluginRef = "dev.example.private-skill"
+	var gotPath string
+	pluginOdooTestServer(t, func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{})
+	})
+	t.Setenv("MULTICA_BACKEND_MODE", "odoo")
+
+	cmd := pluginOdooTestCmd()
+	if _, err := captureStdout(t, func() error {
+		return runPluginStatus(cmd, []string{pluginRef})
+	}); err != nil {
+		t.Fatalf("runPluginStatus: %v", err)
+	}
