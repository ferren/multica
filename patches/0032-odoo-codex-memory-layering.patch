+// Native Codex memories are useful across follow-up tasks, but must be no
+// broader than the same agent/issue scope as the resumed conversation. A
+// local_directory task has a fresh codex-home every time, so this locks the
+// durable-store link rather than accidentally falling back to ~/.codex.
+func TestPrepareCodexMemoriesDir_LocalDirectoryIsScopedAcrossTaskIDs(t *testing.T) {
+	t.Parallel()
+	root := t.TempDir()
+	sharedHome := filepath.Join(root, "shared")
+	key := filepath.Join("agent-1", "issue-1")
+	opts := CodexHomeOptions{IsLocalDirectory: true, SessionStoreKey: key}
+
+	home1 := filepath.Join(root, "task-1", "codex-home")
+	if err := os.MkdirAll(home1, 0o755); err != nil {
+		t.Fatalf("mkdir home1: %v", err)
+	}
+	if err := prepareCodexMemoriesDir(home1, sharedHome, opts, testLogger()); err != nil {
+		t.Fatalf("round 1 prepare: %v", err)
+	}
+	memory := filepath.Join(home1, "memories", "raw_memories.md")
+	if err := os.WriteFile(memory, []byte("only issue 1"), 0o644); err != nil {
+		t.Fatalf("write native memory: %v", err)
+	}
+
+	home2 := filepath.Join(root, "task-2", "codex-home")
+	if err := os.MkdirAll(home2, 0o755); err != nil {
+		t.Fatalf("mkdir home2: %v", err)
+	}
+	if err := prepareCodexMemoriesDir(home2, sharedHome, opts, testLogger()); err != nil {
+		t.Fatalf("round 2 prepare: %v", err)
+	}
+	data, err := os.ReadFile(filepath.Join(home2, "memories", "raw_memories.md"))
+	if err != nil || string(data) != "only issue 1" {
+		t.Fatalf("round 2 cannot read issue-scoped native memory: err=%v data=%q", err, data)
+	}
+
+	otherHome := filepath.Join(root, "task-other", "codex-home")
+	if err := os.MkdirAll(otherHome, 0o755); err != nil {
+		t.Fatalf("mkdir other home: %v", err)
+	}
+	otherOpts := CodexHomeOptions{IsLocalDirectory: true, SessionStoreKey: filepath.Join("agent-1", "issue-2")}
+	if err := prepareCodexMemoriesDir(otherHome, sharedHome, otherOpts, testLogger()); err != nil {
+		t.Fatalf("other issue prepare: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(otherHome, "memories", "raw_memories.md")); !os.IsNotExist(err) {
+		t.Fatalf("other issue must not see issue 1 native memory, err=%v", err)
+	}
+}
