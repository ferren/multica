+// codexCompactOutcomeKind classifies how an async thread/compact/start ended.
+// The kinds map onto the recovery contract (issue 568):
+//   - succeeded: history was compacted; continuing the SAME thread is safe.
+//   - requestRefused: the app-server rejected the compact request itself —
+//     unknown method on an old runtime, a compaction config fault, a thread
+//     that refuses direct input. Compaction never ran, so the conversation is
+//     intact: recoverable by fixing the config, never by retrying now.
+//   - failedTurn: compaction ran and its turn failed (provider error, or the
+//     summarization itself hit the capacity limit). The thread stays over
+//     limit with no remaining cure — permanently unrecoverable.
+//   - timedOut / aborted: the bounded wait ended without a verdict. Nothing
+//     is known; the run gives up without a retry and the platform's next run
+//     re-attempts compaction from scratch (bounded per run).
+type codexCompactOutcomeKind int
+
+const (
+	codexCompactPending codexCompactOutcomeKind = iota
+	codexCompactSucceeded
+	codexCompactRequestRefused
+	codexCompactFailedTurn
+	codexCompactTimedOut
+	codexCompactAborted
+)
+
+type codexCompactResult struct {
+	kind   codexCompactOutcomeKind
+	detail string
+}
+
+// codexCompactWatch observes the notifications one async compaction emits,
+// from the single stdout reader goroutine, and reports a single resolved
+// outcome to the waiting lifecycle goroutine. All observe* methods are
+// reader-goroutine-only; resolved/result are synchronized for the waiter.
+//
+// The canonical completion signal on Codex 0.166 is the ContextCompaction
+// item: item/completed with item.type "contextCompaction" (app-server
+// bespoke_event_handling drops the deprecated thread/compacted notification
+// for v2 clients). The compaction turn's own lifecycle is watched too: a
+// failed compact turn or a terminal error notification resolves failure even
+// if no item ever appears. Duplicate deliveries after resolution are ignored
+// by construction — resolved gates every transition.
+type codexCompactWatch struct {
+	mu       sync.Mutex
+	resolved bool
+	result   codexCompactResult
+	itemID   string
+	ch       chan codexCompactResult // buffered 1; closed by resolve
+}
+
+func newCodexCompactWatch() *codexCompactWatch {
+	return &codexCompactWatch{ch: make(chan codexCompactResult, 1)}
+}
+
+// observe feeds one notification to the watch. It never consumes the
+// notification: the ordinary handlers keep running so existing semantics
+// (semantic-activity pings, the turnCompleted guard) are unchanged.
+func (w *codexCompactWatch) observe(method string, params map[string]any) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.resolved {
+		return
+	}
+	switch method {
+	case "item/started", "item/completed":
+		item, _ := params["item"].(map[string]any)
+		itemType, _ := item["type"].(string)
+		if itemType != "contextCompaction" {
+			return
+		}
+		id, _ := item["id"].(string)
+		if id != "" {
+			w.itemID = id
+		}
+		if method == "item/completed" {
+			w.resolveLocked(codexCompactResult{kind: codexCompactSucceeded})
+		}
+	case "thread/compacted":
+		// Deprecated pre-item signal (ContextCompactedNotification). Codex
+		// 0.166 no longer emits it for v2 clients, but a runtime that still
+		// does has unambiguously finished compacting.
+		w.resolveLocked(codexCompactResult{kind: codexCompactSucceeded})
+	case "turn/completed":
+		status := extractNestedString(params, "turn", "status")
+		switch status {
+		case "failed":
+			detail := extractNestedString(params, "turn", "error", "message")
+			w.resolveLocked(codexCompactResult{kind: codexCompactFailedTurn, detail: detail})
+		case "completed":
+			// The compact turn finished cleanly. Normally the
+			// contextCompaction item has already resolved the watch; taking
+			// this as success too covers a stream that delivered the item to
+			// history without notifying. A wrong guess is self-correcting:
+			// the continuation turn would fail capacity again and the
+			// recovery is spent, which is the bounded outcome anyway.
+			w.resolveLocked(codexCompactResult{kind: codexCompactSucceeded})
+		}
+	case "error":
+		if willRetry, _ := params["willRetry"].(bool); willRetry {
+			return
+		}
+		detail := extractNestedString(params, "error", "message")
+		if detail == "" {
+			detail = extractNestedString(params, "message")
+		}
+		w.resolveLocked(codexCompactResult{kind: codexCompactFailedTurn, detail: detail})
+	}
+}
+
+// resolveTerminal ends the watch without a protocol verdict (timeout,
+// cancellation, process exit). It races observe only via resolveLocked's
+// resolved flag, so the first verdict — protocol or terminal — wins.
+func (w *codexCompactWatch) resolveTerminal(result codexCompactResult) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.resolveLocked(result)
+}
+
+func (w *codexCompactWatch) resolveLocked(result codexCompactResult) {
+	if w.resolved {
+		return
+	}
+	w.resolved = true
+	w.result = result
+	w.ch <- result
+	close(w.ch)
+}
+
+// wait blocks until the watch resolves. Terminal conditions are fed to
+// resolveTerminal by the driver's select cases, so a plain receive suffices.
+func (w *codexCompactWatch) wait() codexCompactResult {
+	return <-w.ch
+}
+
+func (w *codexCompactWatch) resolvedSnapshot() bool {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return w.resolved
+}
