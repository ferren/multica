+	}
+	if fileManagedByMultica(filepath.Join(dir, "no-frontmatter.md")) {
+		t.Fatal("file with no frontmatter must not be treated as platform-managed")
+	}
+	if fileManagedByMultica(filepath.Join(dir, "missing.md")) {
