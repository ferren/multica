+package cli
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestTaskCredentialRequestsUseCurrentPair(t *testing.T) {
+	var calls atomic.Int32
+	var rejected atomic.Bool
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		if rejected.Load() {
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		token := r.Header.Get("X-GALAXY-ACCESS-TOKEN")
+		key := r.Header.Get("X-GALAXY-API-KEY")
+		if token != "Bearer token-"+key || r.Header.Get("X-Agent-ID") != "agent" {
+			t.Error("credential pair or identity was mixed")
+		}
+		if strings.HasSuffix(r.URL.Path, "/upload-file") {
+			fmt.Fprint(w, `{"id":"attachment"}`)
+		} else {
+			fmt.Fprint(w, `{}`)
+		}
+	}))
+	defer srv.Close()
+	path := filepath.Join(t.TempDir(), "credential.json")
+	credential := OdooTaskCredential{ServerURL: srv.URL, TaskID: "task", AgentID: "agent",
+		ExpiresAt: time.Now().Add(time.Hour)}
+	client := NewAPIClient(srv.URL, "", "stale-environment-token")
+	client.OdooBackend, client.TaskCredentialFile = true, path
+	client.TaskID, client.AgentID = "task", "agent"
+	ctx := context.Background()
+	for _, key := range []string{"first", "second"} {
+		credential.AccessToken, credential.APIKey = "token-"+key, key
+		if err := WriteTaskCredential(path, credential); err != nil {
+			t.Fatal(err)
+		}
+		if err := client.GetJSON(ctx, "/api/issues/1", nil); err != nil {
+			t.Fatal(err)
+		}
+		if err := client.PatchJSON(ctx, "/api/issues/1", map[string]string{"status": "in_review"}, nil); err != nil {
+			t.Fatal(err)
+		}
+		if err := client.PostJSON(ctx, "/api/issues/1/comments", map[string]string{"content": "result"}, nil); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := client.UploadIssueAttachment(ctx, []byte("file"), "result.txt", "1"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if calls.Load() != 8 {
+		t.Fatalf("writes were replayed: %d requests", calls.Load())
+	}
+	if runtime.GOOS != "windows" {
+		info, _ := os.Stat(path)
+		if info.Mode().Perm() != 0600 {
+			t.Fatal("credential is not private")
+		}
+	}
+	for _, mutate := range []func(){
+		func() { credential.ExpiresAt = time.Now().Add(-time.Second) },
+		func() { credential.TaskID = "other-task" },
+		func() { credential.AgentID = "other-agent" },
+		func() { credential.ServerURL = "https://another-server.invalid" },
+	} {
+		credential.ExpiresAt, credential.TaskID, credential.AgentID, credential.ServerURL = time.Now().Add(time.Hour), "task", "agent", srv.URL
+		mutate()
+		if err := WriteTaskCredential(path, credential); err != nil {
+			t.Fatal(err)
+		}
+		if err := client.PostJSON(ctx, "/api/issues/1/comments", nil, nil); err == nil {
+			t.Fatal("invalid credential did not fail closed")
+		}
+	}
+	if err := os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.GetJSON(ctx, "/api/issues/1", nil); err == nil || calls.Load() != 8 {
+		t.Fatal("missing credential fell back to environment")
+	}
+	credential.ExpiresAt, credential.TaskID, credential.AgentID, credential.ServerURL = time.Now().Add(time.Hour), "task", "agent", srv.URL
+	if err := WriteTaskCredential(path, credential); err != nil {
+		t.Fatal(err)
+	}
+	rejected.Store(true)
+	var httpErr *HTTPError
+	err := client.PostJSON(ctx, "/api/issues/1/comments", nil, nil)
+	if !errors.As(err, &httpErr) || !httpErr.TaskScoped || calls.Load() != 9 {
+		t.Fatal("task rejection lost identity or retried business write")
+	}
+}
+
+func TestTaskCredentialConcurrentReplacement(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "credential.json")
+	credential := OdooTaskCredential{ServerURL: "https://server.test", TaskID: "task", AgentID: "agent", ExpiresAt: time.Now().Add(time.Hour)}
+	credential.AccessToken, credential.APIKey = "pair-0", "pair-0"
+	if err := WriteTaskCredential(path, credential); err != nil {
+		t.Fatal(err)
+	}
+	var readers sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		readers.Add(1)
+		go func() {
+			defer readers.Done()
+			for j := 0; j < 100; j++ {
+				pair, err := readTaskCredential(path, credential.ServerURL, "task", "agent")
+				if err != nil || pair.AccessToken != pair.APIKey {
+					t.Error("concurrent read did not receive a complete pair")
+					return
+				}
+			}
+		}()
+	}
+	for i := 1; i <= 50; i++ {
+		credential.AccessToken, credential.APIKey = fmt.Sprintf("pair-%d", i), fmt.Sprintf("pair-%d", i)
+		if err := WriteTaskCredential(path, credential); err != nil {
+			t.Fatal(err)
+		}
+	}
+	readers.Wait()
+}
