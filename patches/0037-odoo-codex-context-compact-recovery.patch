+// TestCodexCompactWaitTimeoutOverride verifies the test hook itself, so the
+// shrunken budgets in the timeout tests cannot silently stop applying.
+func TestCodexCompactWaitTimeoutOverride(t *testing.T) {
+	if got := codexCompactWaitTimeout(); got != defaultCodexCompactWaitTimeout {
+		t.Fatalf("default override leaked between tests: %s", got)
+	}
+	codexCompactWaitNanos.Store(int64(1500 * time.Millisecond))
+	defer codexCompactWaitNanos.Store(0)
+	if got := codexCompactWaitTimeout(); got != 1500*time.Millisecond {
+		t.Fatalf("override not applied: %s", got)
+	}
+}
