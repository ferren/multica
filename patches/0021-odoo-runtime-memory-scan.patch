+// handleMemoryScan inventories the runtime-local memory files for the local
+// directories the server named, and reports them back. Read-only: the platform
+// treats these files as the runtime's own, and only looks at them here.
+func (d *Daemon) handleMemoryScan(ctx context.Context, rt Runtime, pending PendingMemoryScan) {
+	d.logger.Info("runtime local memory scan requested", "runtime_id", rt.ID, "request_id", pending.ID, "provider", rt.Provider, "targets", len(pending.Targets))
+
+	targets := make([]LocalMemoryScanTarget, 0, len(pending.Targets))
+	for _, t := range pending.Targets {
+		targets = append(targets, LocalMemoryScanTarget{LocalDirectoryID: t.LocalDirectoryID, Path: t.Path})
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		d.reportMemoryScanResult(ctx, rt, pending.ID, map[string]any{
+			"status": "failed",
+			"error":  fmt.Sprintf("resolve home directory: %v", err),
+		})
+		return
+	}
+	results, supported, err := scanRuntimeLocalMemories(rt.Provider, home, targets)
+	if err != nil {
+		d.reportMemoryScanResult(ctx, rt, pending.ID, map[string]any{
+			"status": "failed",
+			"error":  err.Error(),
+		})
+		return
+	}
+	// An unsupported provider still reports "completed": the server needs to
+	// record "this runtime has no local memory store" (that flag drives
+	// whether the platform injects memories into the brief at all), which is a
+	// real answer, not a failure.
+	if results == nil {
+		results = []localMemoryScanResult{}
+	}
+	d.reportMemoryScanResult(ctx, rt, pending.ID, map[string]any{
+		"status":    "completed",
+		"supported": supported,
+		"provider":  rt.Provider,
+		"results":   results,
+	})
+}
+
+// reportMemoryScanResult delivers a memory inventory to the server with retry
+// on transient failures.
+func (d *Daemon) reportMemoryScanResult(ctx context.Context, rt Runtime, requestID string, payload map[string]any) {
+	d.reportRuntimeResultWithRetry(ctx, "memory_scan", rt.ID, requestID, func(ctx context.Context) error {
+		return d.client.ReportMemoryScanResult(ctx, rt.ID, requestID, payload)
+	})
+}
