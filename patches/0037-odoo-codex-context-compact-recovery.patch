+// TestCodexContextCompactSkippedAfterToolUse pins the duplicate-side-effect
+// gate: a capacity failure in a turn that already ran a tool never triggers
+// the recovery, because re-issuing the prompt would re-plan on top of the
+// partial work.
+func TestCodexContextCompactSkippedAfterToolUse(t *testing.T) {
+	t.Parallel()
+	if runtime.GOOS == "windows" {
+		t.Skip("shell-script fixture is POSIX-only")
+	}
+
+	fakePath := writeFakeCodexAppServer(t, fakeCodexCompactPreamble+`
+read line
+echo '{"jsonrpc":"2.0","id":3,"result":{}}'
+echo '{"jsonrpc":"2.0","method":"turn/started","params":{"threadId":"thr_prior","turn":{"id":"turn-1"}}}'
+echo '{"jsonrpc":"2.0","method":"item/started","params":{"threadId":"thr_prior","turnId":"turn-1","item":{"type":"commandExecution","id":"cmd-1","command":"make test"}}}'
+echo '{"jsonrpc":"2.0","method":"item/completed","params":{"threadId":"thr_prior","turnId":"turn-1","item":{"type":"commandExecution","id":"cmd-1","aggregatedOutput":"ok"}}}'
+`+fakeCodexCompactHeredoc(codexCompactCapacityTurnCompleted)+`
+read line
+`)
+	dir := filepath.Dir(fakePath)
+	result := executeFakeCodex(t, fakePath, fakeCodexCompactOptions())
+
+	if result.Status != "failed" {
+		t.Fatalf("expected failed result, got %+v", result)
+	}
+	if result.ResumeRejected || result.ResumeRejectedTransient {
+		t.Fatalf("tool-using capacity failures keep today's semantics, got %+v", result)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "compact-start.json")); err == nil {
+		t.Fatal("recovery must not request compaction after observed tool use")
+	}
+	if n := fakeCodexInvocations(t, dir); n != 1 {
+		t.Fatalf("tool-using capacity failures must not relaunch, got %d invocations", n)
+	}
+}
