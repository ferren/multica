+package execenv
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestSkipLocallyPresentSkills(t *testing.T) {
+	// Create a real directory to stand in for the user's local skill, plus a
+	// tmp home so the ~ expansion is deterministic.
+	tmp := t.TempDir()
+	localSkill := filepath.Join(tmp, "my-skill")
+	if err := os.MkdirAll(localSkill, 0o750); err != nil {
+		t.Fatal(err)
+	}
+	rel, err := filepath.Rel(tmp, localSkill)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("HOME", tmp)
+	sourcePath := filepath.ToSlash(filepath.Join("~", rel))
+
+	skills := []SkillContextForEnv{
+		{Name: "present", SourcePath: sourcePath},                 // exists → skip
+		{Name: "absent", SourcePath: "~/does-not-exist/skill"},    // missing → keep
+		{Name: "nopath", SourcePath: ""},                          // no source_path → keep
+		{Name: "rel-notilde", SourcePath: "some/relative/path"},   // non-existent → keep
+	}
+
+	got := skipLocallyPresentSkills(skills)
+	if len(got) != 3 {
+		t.Fatalf("expected 3 kept, got %d: %+v", len(got), got)
+	}
+	for _, s := range got {
+		if s.Name == "present" {
+			t.Fatalf("locally-present skill %q was not skipped", s.Name)
+		}
+	}
+}
+
+func TestSkipLocallyPresentSkills_FilesAreKept(t *testing.T) {
+	// A skill whose source_path points at a *file* (not a dir) must NOT be
+	// skipped — dirExists is directory-specific, so the agent still gets it.
+	tmp := t.TempDir()
+	filePath := filepath.Join(tmp, "not-a-dir")
+	if err := os.WriteFile(filePath, []byte("x"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("HOME", tmp)
+
+	skills := []SkillContextForEnv{
+		{Name: "file", SourcePath: "~/not-a-dir"},
+		{Name: "plain", SourcePath: ""},
+	}
+	got := skipLocallyPresentSkills(skills)
+	if len(got) != 2 {
+		t.Fatalf("file-pathed skill should be kept; got %d kept", len(got))
+	}
+}
+
+func TestExpandHome(t *testing.T) {
+	tmp := t.TempDir()
+	t.Setenv("HOME", tmp)
+	for _, tc := range []struct{ in, want string }{
+		{"~", tmp},
+		{"~/foo/bar", filepath.Join(tmp, "foo", "bar")},
+		{"/abs/path", "/abs/path"},
+		{"relative/path", "relative/path"},
+	} {
+		if got := expandHome(tc.in); got != tc.want {
+			t.Errorf("expandHome(%q) = %q, want %q", tc.in, got, tc.want)
+		}
+	}
+}
