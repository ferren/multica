+// splitFrontmatter separates a memory file's YAML frontmatter from its body.
+// ok is false when the file has no "---" delimited frontmatter block at all
+// (still a valid memory file — see parseLocalMemoryFile).
+func splitFrontmatter(text string) (fm localMemoryFrontmatter, body string, ok bool) {
+	if !strings.HasPrefix(text, "---\n") {
+		return fm, text, false
+	}
+	rest := text[len("---\n"):]
+	end := strings.Index(rest, "\n---")
+	if end < 0 {
+		return fm, text, false
+	}
+	if yaml.Unmarshal([]byte(rest[:end+1]), &fm) != nil {
+		return localMemoryFrontmatter{}, text, false
+	}
+	return fm, strings.TrimPrefix(rest[end+len("\n---"):], "\n"), true
+}
