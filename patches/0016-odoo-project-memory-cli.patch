+	dir := chdirTemp(t)
+	writeProjectContextFile(t, dir, "7")
+	memDir := filepath.Join(dir, "memories")
+	if err := os.MkdirAll(memDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	write := func(name, body string) {
+		if err := os.WriteFile(filepath.Join(memDir, name), []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("a-fact.md", "---\nname: a-fact\ndescription: a\nmetadata:\n  type: reference\n---\nbody a\n")
+	write("huge.md", "---\nname: huge\ndescription: h\n---\n"+strings.Repeat("长", memoryContentMaxRunes+1))
+
+	var posted []map[string]any
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]any
+		json.NewDecoder(r.Body).Decode(&body)
+		posted = append(posted, body)
+		json.NewEncoder(w).Encode(memoryDTO{ID: 1, Name: body["name"].(string), MemoryType: body["memory_type"].(string), Scope: "project"})
+	}))
+	defer srv.Close()
+
+	cmd := newMemoryTestCmd(t, srv.URL, nil, nil)
+	if err := runMemoryImport(cmd, []string{memDir}); err != nil {
+		t.Fatalf("runMemoryImport: %v", err)
+	}
+	if len(posted) != 1 {
+		t.Fatalf("posted %d memories, want 1 (the oversized one is skipped): %+v", len(posted), posted)
+	}
+	if posted[0]["name"] != "a-fact" || posted[0]["memory_type"] != "reference" {
+		t.Fatalf("posted = %+v", posted[0])
+	}
+	if posted[0]["project_id"] != "7" {
+		t.Fatalf("project_id = %v, want 7", posted[0]["project_id"])
+	}
+}
