+// TestCodexCompactWatchObservation exercises the watch directly: resolution
+// precedence, duplicate delivery, foreign items, and retryable errors.
+func TestCodexCompactWatchObservation(t *testing.T) {
+	t.Parallel()
+
+	t.Run("duplicate completion resolves once", func(t *testing.T) {
+		t.Parallel()
+		w := newCodexCompactWatch()
+		w.observe("item/completed", map[string]any{
+			"threadId": "thr", "turnId": "t1",
+			"item": map[string]any{"type": "contextCompaction", "id": "cc"},
+		})
+		w.observe("item/completed", map[string]any{
+			"threadId": "thr", "turnId": "t1",
+			"item": map[string]any{"type": "contextCompaction", "id": "cc"},
+		})
+		w.observe("thread/compacted", map[string]any{"threadId": "thr", "turnId": "t1"})
+		w.observe("error", map[string]any{
+			"threadId": "thr", "turnId": "t1", "willRetry": false,
+			"error": map[string]any{"message": "late failure"},
+		})
+		if r := w.wait(); r.kind != codexCompactSucceeded {
+			t.Fatalf("expected succeeded to survive duplicates, got %+v", r)
+		}
+	})
+
+	t.Run("terminal error resolves failure", func(t *testing.T) {
+		t.Parallel()
+		w := newCodexCompactWatch()
+		w.observe("error", map[string]any{
+			"threadId": "thr", "turnId": "t1", "willRetry": true,
+			"error": map[string]any{"message": "transient"},
+		})
+		if w.resolvedSnapshot() {
+			t.Fatal("retryable error must not resolve the watch")
+		}
+		w.observe("error", map[string]any{
+			"threadId": "thr", "turnId": "t1", "willRetry": false,
+			"error": map[string]any{"message": "terminal failure"},
+		})
+		r := w.wait()
+		if r.kind != codexCompactFailedTurn || r.detail != "terminal failure" {
+			t.Fatalf("expected failed turn with detail, got %+v", r)
+		}
+	})
+
+	t.Run("foreign item types ignored", func(t *testing.T) {
+		t.Parallel()
+		w := newCodexCompactWatch()
+		w.observe("item/completed", map[string]any{
+			"threadId": "thr", "turnId": "t1",
+			"item": map[string]any{"type": "agentMessage", "id": "m1", "text": "hi"},
+		})
+		w.observe("item/started", map[string]any{
+			"threadId": "thr", "turnId": "t1",
+			"item": map[string]any{"type": "commandExecution", "id": "c1"},
+		})
+		if w.resolvedSnapshot() {
+			t.Fatal("non-compaction items must not resolve the watch")
+		}
+		w.resolveTerminal(codexCompactResult{kind: codexCompactTimedOut})
+		if r := w.wait(); r.kind != codexCompactTimedOut {
+			t.Fatalf("expected the terminal verdict, got %+v", r)
+		}
+	})
+}
