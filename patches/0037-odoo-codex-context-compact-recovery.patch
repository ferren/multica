+func fakeCodexInvocations(t *testing.T, dir string) int {
+	t.Helper()
+	raw, err := os.ReadFile(filepath.Join(dir, "invocations"))
+	if err != nil {
+		return 0
+	}
+	var n int
+	if _, err := fmt.Sscanf(strings.TrimSpace(string(raw)), "%d", &n); err != nil {
+		t.Fatalf("parse invocations %q: %v", raw, err)
+	}
+	return n
+}
+
+func fakeCodexReadRequest(t *testing.T, dir, name string) map[string]any {
+	t.Helper()
+	raw, err := os.ReadFile(filepath.Join(dir, name))
+	if err != nil {
+		t.Fatalf("read %s: %v (request never arrived)", name, err)
+	}
+	var request struct {
+		Method string         `json:"method"`
+		Params map[string]any `json:"params"`
+	}
+	if err := json.Unmarshal(raw, &request); err != nil {
+		t.Fatalf("parse %s: %v", name, err)
+	}
+	if request.Params == nil {
+		request.Params = map[string]any{}
+	}
+	request.Params["_method"] = request.Method
+	return request.Params
+}
