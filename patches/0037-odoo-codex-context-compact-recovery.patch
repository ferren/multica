+// runCodexContextCompaction performs the bounded context-compaction recovery
+// for a turn that failed on context-window capacity (issue 568): ask the live
+// app-server to compact the thread it still holds loaded, wait a bounded time
+// for the compaction to finish, and report how it ended. The caller decides
+// from the outcome whether the same thread may be continued.
+//
+// Bounded by construction: one request, one watch, one timer
+// (codexCompactWaitTimeout), and every terminal condition — cancellation,
+// process exit, timeout — resolves the watch instead of reviving the failed
+// turn. A cancelled or timed-out run never retries here.
+func (b *codexBackend) runCodexContextCompaction(runCtx context.Context, c *codexClient, threadID string, logger *slog.Logger) codexCompactResult {
+	started := time.Now()
+	w := newCodexCompactWatch()
+	c.armCompactWatch(w)
+	defer c.armCompactWatch(nil)
+
+	if logger == nil {
+		logger = slog.Default()
+	}
+	logger.Info("codex lifecycle",
+		"phase", "compact_started",
+		"task_id", b.cfg.TaskID,
+		"runtime_id", b.cfg.RuntimeID,
+		"pid", c.pid,
+		"thread_id", threadID,
+		"timeout", codexCompactWaitTimeout().String(),
+	)
+	// Keep the surface alive while the model summarizes: the compact turn
+	// emits its own turn/started, but this covers streams that go straight to
+	// the compaction model call without visible turn lifecycle.
+	if c.onMessage != nil {
+		c.onMessage(Message{Type: MessageStatus, Status: "running", SessionID: threadID})
+	}
+
+	// The RPC acks immediately (the app-server submits Op::Compact and
+	// returns {}); compaction then streams item/turn notifications. Events can
+	// race the ack, so the watch is armed before the request and the ack wait
+	// also selects on the watch.
+	type compactAck struct {
+		err error
+	}
+	ackCh := make(chan compactAck, 1)
+	go func() {
+		_, err := c.request(runCtx, "thread/compact/start", map[string]any{
+			"threadId": threadID,
+		})
+		ackCh <- compactAck{err: err}
+	}()
+
+	timer := time.NewTimer(codexCompactWaitTimeout())
+	defer stopTimer(timer)
+
+	select {
+	case r := <-w.ch:
+		b.logCompactOutcome(logger, r, started, threadID, "events_before_ack")
+		return r
+	case ack := <-ackCh:
+		if ack.err != nil {
+			kind := codexCompactRequestRefused
+			if runCtx.Err() != nil || isCodexTransportError(ack.err) {
+				kind = codexCompactAborted
+			}
+			w.resolveTerminal(codexCompactResult{kind: kind, detail: ack.err.Error()})
+			r := w.wait()
+			b.logCompactOutcome(logger, r, started, threadID, "request_failed")
+			return r
+		}
+	case <-timer.C:
+		w.resolveTerminal(codexCompactResult{kind: codexCompactTimedOut})
