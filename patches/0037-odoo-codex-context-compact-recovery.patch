+		return r
+	case <-runCtx.Done():
+		w.resolveTerminal(codexCompactResult{kind: codexCompactAborted, detail: runCtx.Err().Error()})
+		r := w.wait()
+		b.logCompactOutcome(logger, r, started, threadID, "cancelled")
+		return r
+	case <-c.processDone:
+		w.resolveTerminal(codexCompactResult{kind: codexCompactAborted, detail: "codex process exited during compaction"})
+		r := w.wait()
+		b.logCompactOutcome(logger, r, started, threadID, "process_exit")
+		return r
+	}
+
+	// Ack received; compaction is running. Wait for its completion events
+	// under the same bounds.
+	select {
+	case r := <-w.ch:
+		b.logCompactOutcome(logger, r, started, threadID, "completed")
+		return r
+	case <-timer.C:
+		w.resolveTerminal(codexCompactResult{kind: codexCompactTimedOut})
+		r := w.wait()
+		b.logCompactOutcome(logger, r, started, threadID, "wait_timeout")
+		return r
+	case <-runCtx.Done():
+		w.resolveTerminal(codexCompactResult{kind: codexCompactAborted, detail: runCtx.Err().Error()})
+		r := w.wait()
+		b.logCompactOutcome(logger, r, started, threadID, "cancelled")
+		return r
+	case <-c.processDone:
+		w.resolveTerminal(codexCompactResult{kind: codexCompactAborted, detail: "codex process exited during compaction"})
+		r := w.wait()
+		b.logCompactOutcome(logger, r, started, threadID, "process_exit")
+		return r
+	}
+}
+
+func (b *codexBackend) logCompactOutcome(logger *slog.Logger, r codexCompactResult, started time.Time, threadID, boundary string) {
+	outcome := "unknown"
+	switch r.kind {
+	case codexCompactSucceeded:
+		outcome = "succeeded"
+	case codexCompactRequestRefused:
+		outcome = "request_refused"
+	case codexCompactFailedTurn:
+		outcome = "failed_turn"
+	case codexCompactTimedOut:
+		outcome = "timed_out"
+	case codexCompactAborted:
+		outcome = "aborted"
+	}
+	logger.Warn("codex lifecycle",
+		"phase", "compact_finished",
+		"task_id", b.cfg.TaskID,
+		"runtime_id", b.cfg.RuntimeID,
+		"thread_id", threadID,
+		"outcome", outcome,
+		"boundary", boundary,
+		"detail", sanitizeCodexDiagnostic(r.detail),
+		"latency", time.Since(started).Round(time.Millisecond).String(),
+	)
+}
