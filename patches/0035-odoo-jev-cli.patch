+package main
+
+import (
+	"reflect"
+	"testing"
+)
+
+// TestJevRequest pins the /inair_agent_jev/decide body shape per decision
+// form: shared base fields, form-specific extras only when set, and the
+// "Label=Description" option split (first '=' wins; pairs only where a
+// description was actually given — plain labels stay plain strings).
+func TestJevRequest(t *testing.T) {
+	t.Parallel()
+
+	choice := jevRequest("choice", "上下文", "SAFE", []string{"A", "B=描述 B", "C="},
+		"按部门分类", "", "")
+	wantOptions := []any{"A", []string{"B", "描述 B"}, "C="}
+	if !reflect.DeepEqual(choice["options"], wantOptions) {
+		t.Fatalf("options = %#v, want %#v", choice["options"], wantOptions)
+	}
+	if choice["decision_type"] != "choice" || choice["context"] != "上下文" {
+		t.Fatalf("base fields = %#v", choice)
+	}
+	if choice["fallback"] != "SAFE" {
+		t.Fatalf("fallback = %v, want SAFE", choice["fallback"])
+	}
+	if choice["instructions"] != "按部门分类" {
+		t.Fatalf("instructions = %v", choice["instructions"])
+	}
+	for _, absent := range []string{"rubric", "question"} {
+		if _, ok := choice[absent]; ok {
+			t.Fatalf("choice body must not carry %s", absent)
+		}
+	}
+
+	score := jevRequest("score", "ctx", "", nil, "", "评分标准", "")
+	if score["rubric"] != "评分标准" {
+		t.Fatalf("rubric = %v", score["rubric"])
+	}
+	if _, ok := score["fallback"]; ok {
+		t.Fatal("empty fallback must be omitted, so the API treats it as unset")
+	}
+	if _, ok := score["options"]; ok {
+		t.Fatal("score body must not carry options")
+	}
+
+	probability := jevRequest("probability", "ctx", "0.5", nil, "", "", "是吗？")
+	if probability["question"] != "是吗？" || probability["fallback"] != "0.5" {
+		t.Fatalf("probability body = %#v", probability)
+	}
+}
+
+// TestJevProbKeys pins the table's probability ordering: numeric for score's
+// 0-10 band keys (where lexical order would put "10" before "2"), lexical
+// otherwise.
+func TestJevProbKeys(t *testing.T) {
+	t.Parallel()
+
+	numeric := map[string]float64{"10": 0.1, "2": 0.2, "0": 0.7}
+	if got := jevProbKeys(numeric); !reflect.DeepEqual(got, []string{"0", "2", "10"}) {
+		t.Fatalf("numeric order = %v", got)
+	}
+
+	labels := map[string]float64{"yes": 0.8, "no": 0.2}
+	if got := jevProbKeys(labels); !reflect.DeepEqual(got, []string{"no", "yes"}) {
+		t.Fatalf("lexical order = %v", got)
+	}
+}
