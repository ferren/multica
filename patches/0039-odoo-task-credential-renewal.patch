--- /dev/null
+++ multica/server/internal/daemon/odoo_task_credentials.go
@@ -0,0 +1,125 @@
+package daemon
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/multica-ai/multica/server/internal/cli"
+)
+
+func taskCredentialRefreshDelay(lifetime time.Duration) time.Duration {
+	// Renew halfway through short lifetimes, at most five minutes early.
+	margin := lifetime / 2
+	if margin > 5*time.Minute {
+		margin = 5 * time.Minute
+	}
+	return lifetime - margin
+}
+
+// startOdooTaskCredentials always mints anew, including resumed sessions.
+// The private directory lives outside the reusable project working directory.
+func (d *Daemon) startOdooTaskCredentials(ctx context.Context, task Task) (cli.OdooTaskCredential, string, func(), error) {
+	var empty cli.OdooTaskCredential
+	credential, lifetime, err := d.mintTaskCredential(ctx, task)
+	if err != nil {
+		return empty, "", nil, err
+	}
+	dir, err := os.MkdirTemp(d.cfg.WorkspacesRoot, ".task-credential-*")
+	if err != nil {
+		return empty, "", nil, fmt.Errorf("create private task credential directory")
+	}
+	path, err := filepath.Abs(filepath.Join(dir, "credential.json"))
+	if err == nil {
+		err = cli.WriteTaskCredential(path, credential)
+	}
+	if err != nil {
+		os.RemoveAll(dir)
+		return empty, "", nil, err
+	}
+	refreshCtx, cancel := context.WithCancel(ctx)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		defer os.RemoveAll(dir)
+		d.refreshOdooTaskCredentials(refreshCtx, task, path, credential.ExpiresAt, lifetime)
+	}()
+	stop := func() { cancel(); <-done }
+	return credential, path, stop, nil
+}
+
+func (d *Daemon) mintTaskCredential(ctx context.Context, task Task) (cli.OdooTaskCredential, time.Duration, error) {
+	started := time.Now()
+	mintCtx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	token, key, seconds, err := d.client.MintAgentToken(mintCtx, task)
+	if err != nil {
+		// The response body may contain confidential material. Log only status.
+		var response *requestError
+		if errors.As(err, &response) {
+			return cli.OdooTaskCredential{}, 0, &requestError{StatusCode: response.StatusCode}
+		}
+		return cli.OdooTaskCredential{}, 0, fmt.Errorf("task credential request failed")
+	}
+	lifetime := time.Duration(seconds) * time.Second
+	if token == "" || key == "" || lifetime <= 0 || !time.Now().Before(started.Add(lifetime)) {
+		return cli.OdooTaskCredential{}, 0, fmt.Errorf("invalid task credential response or lifetime")
+	}
+	return cli.OdooTaskCredential{AccessToken: token, APIKey: key,
+		ServerURL: d.cfg.ServerBaseURL, TaskID: task.ID, AgentID: task.AgentID,
+		ExpiresAt: started.Add(lifetime)}, lifetime, nil
+}
+
+func (d *Daemon) refreshOdooTaskCredentials(ctx context.Context, task Task, path string, expiresAt time.Time, lifetime time.Duration) {
+	delay := time.Until(expiresAt) - (lifetime - taskCredentialRefreshDelay(lifetime))
+	failures := 0
+	for {
+		if delay < 10*time.Millisecond {
+			delay = 10 * time.Millisecond
+		}
+		timer := time.NewTimer(delay)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+		credential, nextLifetime, err := d.mintTaskCredential(ctx, task)
+		if ctx.Err() != nil {
+			return
+		}
+		if err == nil {
+			err = cli.WriteTaskCredential(path, credential)
+		}
+		if err == nil {
+			failures = 0
+			expiresAt, lifetime = credential.ExpiresAt, nextLifetime
+			delay = time.Until(expiresAt) - (lifetime - taskCredentialRefreshDelay(lifetime))
+			d.logger.Debug("task credential renewed", "task_id", task.ID, "runtime_id", task.RuntimeID)
+			continue
+		}
+		var response *requestError
+		status := 0
+		if errors.As(err, &response) {
+			status = response.StatusCode
+		}
+		d.logger.Warn("task credential renewal failed", "task_id", task.ID,
+			"runtime_id", task.RuntimeID, "status", status, "error", err.Error())
+		failures++
+		if (status >= 400 && status < 500 && status != 408 && status != 429) || failures >= 12 {
+			return
+		}
+		// Only credential issuance retries. Business writes are never replayed.
+		// An expired snapshot stays unreadable until a successful renewal.
+		delay = lifetime / 8
+		if delay > 5*time.Second {
+			delay = 5 * time.Second
+		}
+		if delay < 100*time.Millisecond {
+			delay = 100 * time.Millisecond
+		}
+	}
+}
