+func runDocCommentAdd(cmd *cobra.Command, args []string) error {
+	output, _ := cmd.Flags().GetString("output")
+	if output != "table" && output != "json" {
+		return fmt.Errorf("--output must be table or json")
+	}
+	content, _, err := resolveSkillContentFlag(cmd)
+	if err != nil {
+		return err
+	}
+	if strings.TrimSpace(content) == "" {
+		return fmt.Errorf("pass comment text with --content, --content-file, or --content-stdin")
+	}
+	parent, _ := cmd.Flags().GetString("parent")
+	quote, _ := cmd.Flags().GetString("quote")
+	prefix, _ := cmd.Flags().GetString("prefix")
+	suffix, _ := cmd.Flags().GetString("suffix")
+	body := map[string]string{"content": content}
+	if strings.TrimSpace(parent) != "" {
+		if quote != "" || prefix != "" || suffix != "" {
+			return fmt.Errorf("--parent cannot be combined with --quote, --prefix, or --suffix")
+		}
+		body["parent_id"] = strings.TrimSpace(parent)
+	} else {
+		if strings.TrimSpace(quote) == "" {
+			return fmt.Errorf("--quote is required for a new discussion")
+		}
+		body["anchor_quote"] = quote
+		body["anchor_prefix"] = prefix
+		body["anchor_suffix"] = suffix
+	}
+	client, err := newAPIClient(cmd)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := cli.APIContext(context.Background())
+	defer cancel()
+	id, err := resolveDocRef(ctx, client, args[0], false)
+	if err != nil {
+		return err
+	}
+	var comment map[string]any
+	if err := client.PostJSON(ctx, "/api/docs/"+id+"/comments", body, &comment); err != nil {
+		return fmt.Errorf("add doc comment: %w", err)
+	}
+	if output == "table" {
+		printDocCommentTable([]map[string]any{comment})
+		return nil
+	}
+	return cli.PrintJSON(os.Stdout, comment)
+}
