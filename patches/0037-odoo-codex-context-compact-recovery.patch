+// mergeCodexUsage sums two per-model usage maps for the compaction retry,
+// where both attempts spent tokens on the same task.
+func mergeCodexUsage(prior, current map[string]TokenUsage) map[string]TokenUsage {
+	if len(prior) == 0 {
+		return current
+	}
+	merged := make(map[string]TokenUsage, len(prior)+len(current))
+	for model, u := range prior {
+		merged[model] = u
+	}
+	for model, u := range current {
+		base := merged[model]
+		base.InputTokens += u.InputTokens
+		base.OutputTokens += u.OutputTokens
+		base.CacheReadTokens += u.CacheReadTokens
+		base.CacheWriteTokens += u.CacheWriteTokens
+		base.CostUSDTicks += u.CostUSDTicks
+		merged[model] = base
+	}
+	return merged
+}
