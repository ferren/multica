+// newMemoryTestCmd builds a cobra command carrying the flags the memory
+// runners read, pointed at an httptest server. MULTICA_BACKEND_MODE is cleared
+// so the client does not inherit a real agent environment (where it would
+// rewrite /api to the Odoo prefix and miss the test handler).
+func newMemoryTestCmd(t *testing.T, serverURL string, flags map[string]string, bools map[string]bool) *cobra.Command {
+	t.Helper()
+	// Neutralize the ambient agent environment: without this the client would
+	// inherit Odoo mode (rewriting /api to the Odoo prefix, past the test
+	// handler) and the daemon-context guard would demand a mat_ token.
+	t.Setenv("MULTICA_BACKEND_MODE", "")
+	t.Setenv("MULTICA_AGENT_ID", "")
+	t.Setenv("MULTICA_TASK_ID", "")
+	t.Setenv("MULTICA_DAEMON_PORT", "")
+	t.Setenv("MULTICA_TOKEN", "mat_test")
+	cmd := &cobra.Command{Use: "memory-test"}
+	cmd.Flags().String("server-url", "", "")
+	cmd.Flags().String("workspace-id", "", "")
+	cmd.Flags().String("profile", "", "")
+	cmd.Flags().String("project", "", "")
+	cmd.Flags().String("output", "json", "")
+	cmd.Flags().String("type", "", "")
+	cmd.Flags().String("name", "", "")
+	cmd.Flags().String("query", "", "")
+	cmd.Flags().String("description", "", "")
+	cmd.Flags().String("content", "", "")
+	cmd.Flags().String("content-file", "", "")
+	cmd.Flags().Bool("global", false, "")
+	cmd.Flags().Bool("full", false, "")
+	cmd.Flags().Bool("all", false, "")
+	cmd.Flags().Bool("dry-run", false, "")
+	cmd.Flags().Bool("allow-external-file", false, "")
+	_ = cmd.Flags().Set("server-url", serverURL)
+	_ = cmd.Flags().Set("workspace-id", "ws-1")
+	for k, v := range flags {
+		if err := cmd.Flags().Set(k, v); err != nil {
+			panic(err)
+		}
+	}
+	for k, v := range bools {
+		if v {
+			if err := cmd.Flags().Set(k, "true"); err != nil {
+				panic(err)
+			}
+		}
+	}
+	return cmd
+}
