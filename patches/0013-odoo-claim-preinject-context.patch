+// readFilename is a small helper for brief-render tests that write into a
+// temp dir under both CLAUDE.md and AGENTS.md depending on provider/kind.
+func readFilename(t *testing.T, dir, name string) string {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(dir, name))
+	if err != nil {
+		t.Fatalf("read %s: %v", name, err)
+	}
+	return string(data)
+}
+
+// TestPreInjectedIssueContext locks in 方案B (TASK-1-17-1): the backend
+// pre-injects the issue body / metadata / recent comments into the brief's
+// `## Issue Context` section so the agent starts turn 0 with full context. The
+// section must render every injected block when present, fall back to an
+// explicit CLI fetch list when nothing was injected (old backend / bare issue),
+// and appear only on the issue-scoped kinds (comment / assignment) — never on
+// chat / quick-create / autopilot.
+func TestPreInjectedIssueContext(t *testing.T) {
+	t.Parallel()
+
+	richAssignment := TaskContextForEnv{
+		IssueID:          "issue-rich",
+		IssueDescription: "Replace the login redirect. See spec below.",
+		IssueMetadata:    `{"pr_url": "https://example.com/pr/1", "decision": "go"}`,
+		RecentComments: []RecentCommentForEnv{{
+			ID:         "c1",
+			ThreadID:   "t1",
+			AuthorType: "member",
+			AuthorName: "Alice",
+			Content:    "Please also handle the logout path.",
+			CreatedAt:  "2026-07-19T10:00:00Z",
+		}, {
+			ID:         "c2",
+			ThreadID:   "t1",
+			AuthorType: "agent",
+			AuthorName: "bob-bot",
+			Content:    "On it. Pushed a draft.",
+			CreatedAt:  "2026-07-19T11:00:00Z",
+		}},
+	}
+
+	t.Run("assignment_renders_all_blocks", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		if _, err := InjectRuntimeConfig(dir, "claude", richAssignment); err != nil {
+			t.Fatalf("InjectRuntimeConfig failed: %v", err)
+		}
+		s := readFilename(t, dir, "CLAUDE.md")
+		for _, want := range []string{
+			"## Issue Context",
+			"**Issue description** (pre-injected)",
+			"Replace the login redirect.",
+			"**Metadata** (pre-injected)",
+			`"pr_url": "https://example.com/pr/1"`,
+			"**Recently active comments**",
+			"comment `c1`",
+			"Alice",
+			"Another agent (bob-bot)",
+			"[thread `t1`]",
+			"This context is pre-injected by the backend",
+		} {
+			if !strings.Contains(s, want) {
+				t.Errorf("rich assignment brief missing %q\n---\n%s", want, s)
+			}
+		}
+		// Pre-injected → the "no context was pre-injected" fallback must NOT appear.
+		if strings.Contains(s, "No context was pre-injected") {
+			t.Errorf("rich brief should not show the empty-issue fallback\n---\n%s", s)
+		}
+	})
+
+	t.Run("empty_issue_falls_back_to_cli_list", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		if _, err := InjectRuntimeConfig(dir, "claude", TaskContextForEnv{IssueID: "issue-bare"}); err != nil {
+			t.Fatalf("InjectRuntimeConfig failed: %v", err)
+		}
+		s := readFilename(t, dir, "CLAUDE.md")
+		for _, want := range []string{
+			"## Issue Context",
+			"No context was pre-injected by this backend",
+			"multica issue get issue-bare --output json",
+			"multica issue metadata list issue-bare --output json",
+			"multica issue comment list issue-bare --roots-only --summary --output json",
+		} {
+			if !strings.Contains(s, want) {
+				t.Errorf("bare assignment brief missing fallback %q\n---\n%s", want, s)
+			}
+		}
+		// Empty injection must not render the injected-block markers.
+		for _, banned := range []string{
+			"**Issue description** (pre-injected)",
+			"**Metadata** (pre-injected)",
+			"**Recently active comments**",
+		} {
+			if strings.Contains(s, banned) {
+				t.Errorf("bare brief should not render injected-block marker %q\n---\n%s", banned, s)
+			}
+		}
+	})
+
+	t.Run("comment_task_also_gets_section", func(t *testing.T) {
+		t.Parallel()
+		dir := t.TempDir()
+		ctx := richAssignment
+		ctx.IssueID = "issue-comment"
+		ctx.TriggerCommentID = "trigger-1"
+		if _, err := InjectRuntimeConfig(dir, "claude", ctx); err != nil {
+			t.Fatalf("InjectRuntimeConfig failed: %v", err)
+		}
+		s := readFilename(t, dir, "CLAUDE.md")
+		if !strings.Contains(s, "## Issue Context") {
+			t.Errorf("comment brief missing ## Issue Context section\n---\n%s", s)
+		}
+		if !strings.Contains(s, "Replace the login redirect.") {
+			t.Errorf("comment brief missing pre-injected description\n---\n%s", s)
+		}
+	})
+
+	t.Run("non_issue_kinds_omit_section", func(t *testing.T) {
+		t.Parallel()
+		const sentinel = "X9ISSUEDESCSENTINEL9X"
+		cases := []struct {
+			name string
+			ctx  TaskContextForEnv
+		}{
+			{"chat", TaskContextForEnv{ChatSessionID: "chat-1", IssueDescription: sentinel}},
+			{"quick_create", TaskContextForEnv{QuickCreatePrompt: "make a thing", IssueDescription: sentinel}},
+			{"autopilot", TaskContextForEnv{AutopilotRunID: "run-1", IssueDescription: sentinel}},
+		}
+		for _, tc := range cases {
+			tc := tc
+			t.Run(tc.name, func(t *testing.T) {
+				t.Parallel()
+				dir := t.TempDir()
+				if _, err := InjectRuntimeConfig(dir, "claude", tc.ctx); err != nil {
+					t.Fatalf("InjectRuntimeConfig failed: %v", err)
+				}
+				// Provider claude always writes CLAUDE.md regardless of kind.
+				s := readFilename(t, dir, "CLAUDE.md")
+				if strings.Contains(s, "## Issue Context") {
+					t.Errorf("%s brief must not carry ## Issue Context\n---\n%s", tc.name, s)
+				}
+				if strings.Contains(s, sentinel) {
+					t.Errorf("%s brief leaked issue-scoped injection\n---\n%s", tc.name, s)
+				}
+			})
+		}
+	})
+}
