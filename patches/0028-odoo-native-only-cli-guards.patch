+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/spf13/cobra"
+)
+
+func TestFetchChatReadUsesTaskScopedOdooRoute(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	t.Setenv("MULTICA_TOKEN", "agent-token")
+	t.Setenv("MULTICA_ODOO_API_KEY", "agent-api-key")
+	t.Setenv("MULTICA_WORKSPACE_ID", "42")
+	t.Setenv("MULTICA_TASK_ID", "99")
+	t.Setenv("MULTICA_BACKEND_MODE", "odoo")
+
+	var gotPath, gotQuery, gotTaskID string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		gotQuery = r.URL.RawQuery
+		gotTaskID = r.Header.Get("X-Task-ID")
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]any{
+			"channel_type": "odoo", "messages": []any{},
+		})
+	}))
+	defer srv.Close()
+	t.Setenv("MULTICA_SERVER_URL", srv.URL)
+
+	cmd := &cobra.Command{Use: "history"}
+	cmd.Flags().String("server-url", "", "")
+	cmd.Flags().String("workspace-id", "", "")
+	cmd.Flags().String("profile", "", "")
+	cmd.Flags().Int("limit", 0, "")
+	cmd.Flags().String("before", "", "")
+	_ = cmd.Flags().Set("limit", "12")
+	_ = cmd.Flags().Set("before", "cursor-1")
+
+	if _, err := fetchChatRead(cmd, "/api/chat/history", ""); err != nil {
+		t.Fatalf("fetchChatRead: %v", err)
+	}
+	if gotPath != "/multica/agent/chat/history" {
+		t.Fatalf("path = %q, want Odoo chat history route", gotPath)
+	}
+	if gotQuery != "before=cursor-1&limit=12" {
+		t.Fatalf("query = %q", gotQuery)
+	}
+	if gotTaskID != "99" {
+		t.Fatalf("X-Task-ID = %q, want 99", gotTaskID)
+	}
+}
