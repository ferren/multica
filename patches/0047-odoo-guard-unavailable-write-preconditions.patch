+func TestOdooCommentAddReplaysBeforeUploading(t *testing.T) {
+	t.Chdir(t.TempDir())
+	if err := os.WriteFile("report.txt", []byte("report"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	const key = "delivery-1"
+	var uploads, posts atomic.Int32
+	var saved atomic.Bool
+	var change atomic.Bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/multica/agent/issues/1" {
+			fmt.Fprint(w, `{"id":1,"identifier":"TASK-1","capabilities":["odoo-comment-replay-v1"]}`)
+			return
+		}
+		if r.Header.Get("Idempotency-Key") != key || len(r.Header.Get("Idempotency-Fingerprint")) != 64 {
+			t.Error("missing or invalid replay headers")
+		}
+		switch r.URL.Path {
+		case "/multica/agent/issues/1/comments/idempotent":
+			if r.Method != http.MethodGet || r.URL.Query().Get("parent_id") != "8" {
+				t.Errorf("unexpected receipt lookup: %s %s", r.Method, r.URL)
+			}
+			if change.Load() {
+				http.Error(w, `{"error":"different comment"}`, http.StatusUnprocessableEntity)
+			} else if saved.Load() {
+				w.Header().Set("Idempotent-Replayed", "true")
+				fmt.Fprint(w, `{"id":3}`)
+			} else {
+				http.Error(w, `{"code":"comment_receipt_not_found"}`, http.StatusNotFound)
+			}
+		case "/multica/agent/upload-file":
+			uploads.Add(1)
+			if r.FormValue("issue_id") != "1" || r.Header.Get("Idempotency-Parent-Id") != "8" ||
+				r.Header.Get("Idempotency-Attachment") != "0" {
+				t.Error("attachment did not use the comment's receipt and slot")
+			}
+			fmt.Fprint(w, `{"id":"2","markdown_url":"/files/2"}`)
+		case "/multica/agent/issues/1/comments":
+			posts.Add(1)
+			saved.Store(true)
+			http.Error(w, "response lost after commit", http.StatusBadGateway)
+		default:
+			t.Errorf("unexpected request: %s %s", r.Method, r.URL.Path)
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+	setCLITestServerEnv(t, server.URL)
+	t.Setenv("MULTICA_BACKEND_MODE", "odoo")
+
+	run := func(content string) error {
+		cmd := newIssueCommentAddTestCmd()
+		for flag, value := range map[string]string{
+			"content": content, "attachment": "report.txt", "idempotency-key": key, "parent": "8", "output": "table",
+		} {
+			if err := cmd.Flags().Set(flag, value); err != nil {
+				t.Fatal(err)
+			}
+		}
+		return runIssueCommentAdd(cmd, []string{"1"})
+	}
+	stderr := captureStderr(t)
+	defer stderr.restore()
+	if err := run("same comment"); err == nil || !strings.Contains(stderr.read(), "is safe") {
+		t.Fatalf("first attempt should report uncertain delivery with a safe retry hint: %v", err)
+	}
+	if err := run("same comment"); err != nil {
+		t.Fatalf("receipt replay failed: %v", err)
+	}
+	change.Store(true)
+	if err := run("different comment"); err == nil || !strings.Contains(err.Error(), "422") {
+		t.Fatalf("changed request should fail before uploading: %v", err)
+	}
+	if uploads.Load() != 1 || posts.Load() != 1 {
+		t.Fatalf("uploads = %d, posts = %d, want one each", uploads.Load(), posts.Load())
+	}
+}
+
+func TestOdooCommentAddDoesNotPromiseReplay(t *testing.T) {
+	var posts atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.Method == http.MethodGet && r.URL.Path == "/multica/agent/issues/1":
+			fmt.Fprint(w, `{"id":1,"identifier":"TASK-1"}`)
+		case r.Method == http.MethodPost && r.URL.Path == "/multica/agent/issues/1/comments":
+			posts.Add(1)
+			if r.Header.Get("Idempotency-Key") != "" {
+				t.Error("Odoo comment unexpectedly used a replay key")
+			}
+			http.Error(w, "uncertain write", http.StatusBadGateway)
+		default:
+			t.Errorf("unexpected request: %s %s", r.Method, r.URL.Path)
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+	setCLITestServerEnv(t, server.URL)
+	t.Setenv("MULTICA_BACKEND_MODE", "odoo")
+	t.Setenv("MULTICA_TASK_ID", "2")
+
+	cmd := newIssueCommentAddTestCmd()
+	if err := cmd.Flags().Set("content", "result"); err != nil {
+		t.Fatal(err)
+	}
+	stderr := captureStderr(t)
+	defer stderr.restore()
+	err := runIssueCommentAdd(cmd, []string{"1"})
+	if err == nil || !strings.Contains(err.Error(), "502") || strings.Contains(stderr.read(), "is safe") {
+		t.Fatalf("Odoo comment should report uncertain delivery without a safe replay hint: %v", err)
+	}
+	if err := cmd.Flags().Set("idempotency-key", "requested-key"); err != nil {
+		t.Fatal(err)
+	}
+	if err := runIssueCommentAdd(cmd, []string{"1"}); err == nil || !strings.Contains(err.Error(), "does not provide") {
+		t.Fatalf("unsupported replay key should fail before posting: %v", err)
+	}
+	if got := posts.Load(); got != 1 {
+		t.Fatalf("posted %d times, want one", got)
+	}
+}
