+// This file exercises the bounded context-compaction recovery (issue 568):
+// a turn that fails on context-window capacity, after zero tool use, asks the
+// still-running app-server to compact the thread via thread/compact/start and
+// — when compaction succeeds — continues the SAME thread on the next attempt.
+//
+// The Execute-level fixtures drive a fake app-server whose script counts its
+// own invocations, so a test can assert not just the outcome but the bound:
+// exactly one compaction and at most one continuation launch. The capacity
+// failure event is emitted through a quoted heredoc because Codex's fixed
+// message contains an apostrophe ("model's"), which a single-quoted shell
+// string cannot carry.
+
+// codexCompactCapacityTurnCompleted fails the current turn with the typed
+// context-window capacity error exactly as Codex 0.166 reports it.
+const codexCompactCapacityTurnCompleted = `{"jsonrpc":"2.0","method":"turn/completed","params":{"threadId":"thr_prior","turn":{"id":"turn-1","status":"failed","error":{"message":"Codex ran out of room in the model's context window. Start a new thread or clear earlier history before retrying.","codexErrorInfo":"context_window_exceeded"}}}}
+`
+
+// fakeCodexCompactHeredoc wraps a raw JSON line in a quoted heredoc so
+// apostrophes inside provider messages survive the shell.
+func fakeCodexCompactHeredoc(line string) string {
+	return "cat <<'JSONEOF'\n" + line + "JSONEOF\n"
+}
+
+// fakeCodexCompactPreamble is the shared request/response prologue: it counts
+// the invocation, then serves initialize and the thread/resume of thr_prior.
+const fakeCodexCompactPreamble = `
+DIR="$(dirname "$0")"
+INV=1
+if [ -f "$DIR/invocations" ]; then INV=$(( $(cat "$DIR/invocations") + 1 )); fi
+echo "$INV" > "$DIR/invocations"
+read line
+echo '{"jsonrpc":"2.0","id":1,"result":{}}'
+read line
+read line
+printf '%s\n' "$line" > "$DIR/resume-$INV.json"
+echo '{"jsonrpc":"2.0","id":2,"result":{"thread":{"id":"thr_prior"}}}'
+`
+
+// fakeCodexCompactSucceedingTurn completes the current turn with a final
+// agent message, ending a successful invocation.
+const fakeCodexCompactSucceedingTurn = `
+read line
+printf '%s\n' "$line" > "$DIR/turn-start-$INV.json"
+echo '{"jsonrpc":"2.0","id":3,"result":{}}'
+echo '{"jsonrpc":"2.0","method":"turn/started","params":{"threadId":"thr_prior","turn":{"id":"turn-ok"}}}'
+echo '{"jsonrpc":"2.0","method":"item/completed","params":{"threadId":"thr_prior","turnId":"turn-ok","item":{"type":"agentMessage","id":"msg-ok","text":"Continued after compaction","phase":"final_answer"}}}'
+echo '{"jsonrpc":"2.0","method":"turn/completed","params":{"threadId":"thr_prior","turn":{"id":"turn-ok","status":"completed"}}}'
+`
+
+// fakeCodexCompactAcceptAndComplete serves the thread/compact/start request
+// (captured to compact-start.json) and emits the canonical completion signal:
+// the contextCompaction item lifecycle on the compact turn.
+const fakeCodexCompactAcceptAndComplete = `
+read line
+printf '%s\n' "$line" > "$DIR/compact-start.json"
+echo '{"jsonrpc":"2.0","id":4,"result":{}}'
+echo '{"jsonrpc":"2.0","method":"turn/started","params":{"threadId":"thr_prior","turn":{"id":"turn-compact"}}}'
+echo '{"jsonrpc":"2.0","method":"item/started","params":{"threadId":"thr_prior","turnId":"turn-compact","item":{"type":"contextCompaction","id":"cc-1"}}}'
+echo '{"jsonrpc":"2.0","method":"item/completed","params":{"threadId":"thr_prior","turnId":"turn-compact","item":{"type":"contextCompaction","id":"cc-1"}}}'
+`
+
+// fakeCodexCompactStartTurnAndServeFailure reads turn/start, acks it, starts
+// the turn, and fails it on capacity.
+func fakeCodexCompactStartTurnAndServeFailure(invocationTurnID string) string {
+	return `
+read line
+echo '{"jsonrpc":"2.0","id":3,"result":{}}'
+echo '{"jsonrpc":"2.0","method":"turn/started","params":{"threadId":"thr_prior","turn":{"id":"` + invocationTurnID + `"}}'}
+` + fakeCodexCompactHeredoc(codexCompactCapacityTurnCompleted)
+}
