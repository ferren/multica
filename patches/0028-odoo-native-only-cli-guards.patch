+		"/plugins/private/" + pluginRef
+	if gotPath != want {
+		t.Fatalf("path = %q, want %q", gotPath, want)
+	}
+}
+
+func TestRunPluginInstallUsesOdooBackendRoute(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "plugin")
+	var output bytes.Buffer
+	initCmd := &cobra.Command{}
+	initCmd.SetOut(&output)
+	initCmd.Flags().String("key", "dev.example.private-skill", "")
+	initCmd.Flags().String("name", "Private Skill", "")
+	initCmd.Flags().String("publisher", "example.local", "")
+	if err := runPluginInit(initCmd, []string{root}); err != nil {
+		t.Fatalf("plugin init: %v", err)
+	}
+
+	var gotPath string
+	var gotMethod string
+	var gotMultipart bool
+	pluginOdooTestServer(t, func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		gotMethod = r.Method
+		gotMultipart = strings.HasPrefix(r.Header.Get("Content-Type"), "multipart/form-data")
+		_, _ = io.Copy(io.Discard, r.Body)
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"plugin_key": "dev.example.private-skill",
+		})
+	})
+	t.Setenv("MULTICA_BACKEND_MODE", "odoo")
+
+	cmd := pluginOdooTestCmd()
+	if _, err := captureStdout(t, func() error {
+		return runPluginInstall(cmd, []string{root})
+	}); err != nil {
+		t.Fatalf("runPluginInstall: %v", err)
+	}
+	want := "/multica/agent/workspaces/" + testWorkspaceMcpID +
+		"/plugins/private/install"
+	if gotPath != want {
+		t.Fatalf("path = %q, want %q", gotPath, want)
+	}
+	if gotMethod != http.MethodPost {
+		t.Fatalf("method = %q, want POST", gotMethod)
+	}
+	if !gotMultipart {
+		t.Fatalf("request was not a multipart upload")
+	}
+}
