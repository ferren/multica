+		Writes: []LocalMemoryWriteItem{
+			{Name: "redis-session-required", File: "redis-session-required.md",
+				Description: "一句话摘要", MemoryType: "project", Content: "正文"},
+		},
+	})
+	if result.Error != "" {
+		t.Fatalf("unexpected error: %s", result.Error)
+	}
+	if len(result.Written) != 1 || result.Written[0] != "redis-session-required.md" {
+		t.Fatalf("written = %+v", result.Written)
+	}
+	if !fileManagedByMultica(filepath.Join(dir, "redis-session-required.md")) {
+		t.Fatal("written file must carry the managed_by marker")
+	}
+	index, err := os.ReadFile(filepath.Join(dir, "MEMORY.md"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(index), "redis-session-required.md") {
+		t.Fatalf("MEMORY.md should index the new file: %q", string(index))
+	}
+}
