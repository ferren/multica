+// ------------------------------------------------------------------
+// Write side: push memories from the Odoo library down into a runtime's
+// memory directory, and delete platform-managed ones the library no longer
+// wants there.
+// ------------------------------------------------------------------
+
+// LocalMemoryWriteTarget is one local directory's write/delete batch, as sent
+// by the server. LocalDirectoryID is opaque to the daemon and echoed back.
+type LocalMemoryWriteTarget struct {
+	LocalDirectoryID string
+	Path             string
+	Writes           []LocalMemoryWriteItem
+	Deletes          []string
+}
+
+// LocalMemoryWriteItem is one memory file to write. Content is the body only
+// (no frontmatter) — renderMemoryFile generates the frontmatter.
+type LocalMemoryWriteItem struct {
+	Name        string
+	File        string
+	Description string
+	MemoryType  string
+	Content     string
+}
+
+// localMemorySkip is one delete or write the daemon declined to perform, with
+// the reason, so the server-side report can explain it rather than silently
+// leaving the desired state unmet.
+type localMemorySkip struct {
+	File   string `json:"file"`
+	Reason string `json:"reason"`
+}
+
+// localMemoryWriteResult is the per-target write/delete outcome.
+type localMemoryWriteResult struct {
+	LocalDirectoryID string            `json:"local_directory_id"`
+	Written          []string          `json:"written"`
+	Deleted          []string          `json:"deleted"`
+	Skipped          []localMemorySkip `json:"skipped"`
+	Error            string            `json:"error,omitempty"`
+}
+
+// localIndexEntry is one row of the MEMORY.md index.
+type localIndexEntry struct {
+	Name        string
+	File        string
+	Description string
+}
+
+// renderMemoryFile builds the on-disk bytes for a platform-managed memory
+// file: YAML frontmatter (name/description/metadata.type) plus the
+// metadata.managed_by: multica marker that makes the file eligible for
+// deletion by a later dispatch, then a blank line, then the body.
+func renderMemoryFile(name, description, memoryType, content string) ([]byte, error) {
+	var fm localMemoryFrontmatter
+	fm.Name = name
+	fm.Description = description
+	fm.Metadata.Type = memoryType
+	fm.Metadata.ManagedBy = memoryManagedByMultica
+	header, err := yaml.Marshal(fm)
+	if err != nil {
+		return nil, err
+	}
+	var buf strings.Builder
+	buf.WriteString("---\n")
+	buf.Write(header)
+	buf.WriteString("---\n\n")
+	buf.WriteString(strings.TrimSpace(content))
+	buf.WriteString("\n")
+	return []byte(buf.String()), nil
+}
+
+// fileManagedByMultica reports whether an existing memory file carries the
+// managed_by: multica marker. Any read/parse failure is treated as "no" —
+// deletion must fail closed, since the alternative is silently removing a
+// file the platform never wrote.
+func fileManagedByMultica(path string) bool {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return false
+	}
+	text := strings.ReplaceAll(string(raw), "\r\n", "\n")
+	fm, _, ok := splitFrontmatter(text)
+	if !ok {
+		return false
+	}
+	return strings.EqualFold(strings.TrimSpace(fm.Metadata.ManagedBy), memoryManagedByMultica)
+}
+
+// upsertMemoryIndex keeps MEMORY.md's one-line-per-memory index in sync with
+// what was just written/deleted, preserving every other line byte for byte —
+// MEMORY.md is also hand-edited by the runtime and by users, and this must
+// never clobber those lines. A line is matched by its link target
+// "](<file>)" rather than by position, so re-running the same write is a
+// no-op edit rather than a duplicate append.
+func upsertMemoryIndex(dir string, writes []localIndexEntry, deletes []string) error {
+	if len(writes) == 0 && len(deletes) == 0 {
+		return nil
+	}
+	path := filepath.Join(dir, "MEMORY.md")
+	raw, err := os.ReadFile(path)
+	if err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	var lines []string
+	if len(raw) > 0 {
+		lines = strings.Split(strings.TrimRight(string(raw), "\n"), "\n")
+	}
+	indexOf := func(file string) int {
+		marker := "](" + file + ")"
+		for i, l := range lines {
+			if strings.Contains(l, marker) {
+				return i
+			}
+		}
+		return -1
+	}
+	for _, e := range writes {
+		line := fmt.Sprintf("- [%s](%s) — %s", e.Name, e.File, e.Description)
+		if i := indexOf(e.File); i >= 0 {
+			lines[i] = line
+		} else {
+			lines = append(lines, line)
+		}
+	}
+	for _, file := range deletes {
+		if i := indexOf(file); i >= 0 {
+			lines = append(lines[:i], lines[i+1:]...)
+		}
+	}
+	content := strings.Join(lines, "\n")
+	if content != "" {
+		content += "\n"
+	}
+	return os.WriteFile(path, []byte(content), 0o644)
+}
+
+// writeLocalMemoryTarget applies one directory's writes and deletes. It never
+// returns an error for individual file failures — those become skip entries
+// or an empty result set so the caller (and the server) can see exactly what
+// happened per file rather than losing partial progress to a single error.
+func writeLocalMemoryTarget(dir string, target LocalMemoryWriteTarget) localMemoryWriteResult {
+	result := localMemoryWriteResult{
+		LocalDirectoryID: target.LocalDirectoryID,
+		Written:          []string{},
+		Deleted:          []string{},
+		Skipped:          []localMemorySkip{},
+	}
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		result.Error = fmt.Sprintf("create memory dir: %v", err)
+		return result
+	}
+
+	var indexWrites []localIndexEntry
+	var indexDeletes []string
+
+	for _, item := range target.Writes {
+		raw, err := renderMemoryFile(item.Name, item.Description, item.MemoryType, item.Content)
+		if err != nil {
+			result.Skipped = append(result.Skipped, localMemorySkip{File: item.File, Reason: err.Error()})
+			continue
+		}
+		if err := os.WriteFile(filepath.Join(dir, item.File), raw, 0o644); err != nil {
+			result.Skipped = append(result.Skipped, localMemorySkip{File: item.File, Reason: err.Error()})
+			continue
+		}
+		result.Written = append(result.Written, item.File)
+		indexWrites = append(indexWrites, localIndexEntry{Name: item.Name, File: item.File, Description: item.Description})
+	}
+
+	for _, file := range target.Deletes {
+		path := filepath.Join(dir, file)
+		switch info, statErr := os.Stat(path); {
+		case os.IsNotExist(statErr):
+			// Already gone (e.g. a previous delete landed but the report was
+			// lost) — this is success, not a skip, so the desired state still
+			// converges.
+			result.Deleted = append(result.Deleted, file)
+			indexDeletes = append(indexDeletes, file)
+		case statErr != nil:
+			result.Skipped = append(result.Skipped, localMemorySkip{File: file, Reason: statErr.Error()})
+		case info.IsDir():
+			result.Skipped = append(result.Skipped, localMemorySkip{File: file, Reason: "is a directory"})
+		case !fileManagedByMultica(path):
+			result.Skipped = append(result.Skipped, localMemorySkip{File: file, Reason: "not managed by multica"})
+		default:
+			if err := os.Remove(path); err != nil {
+				result.Skipped = append(result.Skipped, localMemorySkip{File: file, Reason: err.Error()})
+				continue
+			}
+			result.Deleted = append(result.Deleted, file)
+			indexDeletes = append(indexDeletes, file)
+		}
+	}
+
+	if err := upsertMemoryIndex(dir, indexWrites, indexDeletes); err != nil {
+		// The memory files themselves already landed/left; only the index
+		// update failed. Surface it without discarding the write/delete
+		// results — a stale index is a smaller problem than reporting a real
+		// write as failed.
+		result.Error = fmt.Sprintf("update MEMORY.md: %v", err)
+	}
+	return result
+}
+
+// writeRuntimeLocalMemories applies every requested target for the given
+// provider. The bool reports whether this provider has a known memory layout
+// at all, same convention as scanRuntimeLocalMemories.
+func writeRuntimeLocalMemories(provider, home string, targets []LocalMemoryWriteTarget) ([]localMemoryWriteResult, bool, error) {
+	if !providerSupportsLocalMemory(provider) {
+		return nil, false, nil
+	}
+	if home == "" {
+		return nil, true, fmt.Errorf("cannot resolve home directory for provider %q", provider)
+	}
+	results := make([]localMemoryWriteResult, 0, len(targets))
+	for _, target := range targets {
+		path := strings.TrimSpace(target.Path)
+		if path == "" {
+			results = append(results, localMemoryWriteResult{
+				LocalDirectoryID: target.LocalDirectoryID,
+				Written:          []string{}, Deleted: []string{}, Skipped: []localMemorySkip{},
+				Error: "empty path",
+			})
+			continue
+		}
+		dir := claudeMemoryDir(home, path)
+		if dir == "" {
+			results = append(results, localMemoryWriteResult{
+				LocalDirectoryID: target.LocalDirectoryID,
+				Written:          []string{}, Deleted: []string{}, Skipped: []localMemorySkip{},
+				Error: "cannot resolve memory directory",
+			})
+			continue
+		}
+		results = append(results, writeLocalMemoryTarget(dir, target))
+	}
+	return results, true, nil
+}
