+// TestCodexContextCompactRecoveryIsSpentAfterRelapse pins the per-run bound
+// from the other side: a continuation attempt that fails on capacity again
+// does not compact a second time and does not relaunch again.
+func TestCodexContextCompactRecoveryIsSpentAfterRelapse(t *testing.T) {
+	t.Parallel()
+	if runtime.GOOS == "windows" {
+		t.Skip("shell-script fixture is POSIX-only")
+	}
+
+	fakePath := writeFakeCodexAppServer(t, fakeCodexCompactPreamble+`
+read line
+printf '%s\n' "$line" > "$DIR/turn-start-$INV.json"
+echo '{"jsonrpc":"2.0","id":3,"result":{}}'
+echo '{"jsonrpc":"2.0","method":"turn/started","params":{"threadId":"thr_prior","turn":{"id":"turn-1"}}}'
+`+fakeCodexCompactHeredoc(codexCompactCapacityTurnCompleted)+`
+if [ "$INV" = "1" ]; then
+`+fakeCodexCompactAcceptAndComplete+`
+  read line
+fi
+`)
+	dir := filepath.Dir(fakePath)
+	result, _ := executeFakeCodexCollectingMessages(t, fakePath, fakeCodexCompactOptions(), 30*time.Second)
+
+	if result.Status != "failed" {
+		t.Fatalf("expected failed result, got %+v", result)
+	}
+	if !strings.Contains(result.Error, "ran out of room") {
+		t.Fatalf("expected the capacity failure to surface, got %q", result.Error)
+	}
+	if n := fakeCodexInvocations(t, dir); n != 2 {
+		t.Fatalf("the recovery is spent after one continuation, got %d invocations", n)
+	}
+	// The second invocation must have started a turn (and, being attempt 2,
+	// never received a compact request: compact-start.json stays invocation
+	// 1's alone — the file's mere existence is invocation 1's, so assert the
+	// turn file instead).
+	if _, err := os.Stat(filepath.Join(dir, "turn-start-2.json")); err != nil {
+		t.Fatalf("second invocation should have started a turn: %v", err)
+	}
+}
