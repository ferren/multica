+// TestCodexCompactDiagnosticsCannotChangeMachineDecisions pins the constant
+// parts of the three compaction diagnostics against the error-string
+// classifiers that re-scan the persisted text: a diagnostic must never flip
+// CodexResumeOverflowError or CodexRetiredCompactionError on a failure that
+// is neither. (The daemon-side annotation test pins the same property for
+// taskfailure.Classify at the report boundary.)
+func TestCodexCompactDiagnosticsCannotChangeMachineDecisions(t *testing.T) {
+	t.Parallel()
+
+	texts := []string{
+		codexCompactRefusedDiagnostic("Method not found"),
+		codexCompactRefusedDiagnostic(""),
+		codexCompactTimedOutDiagnostic("watchdog detail", 10*time.Minute),
+		codexCompactTimedOutDiagnostic("", 10*time.Minute),
+		codexCompactFailedDiagnostic("stream disconnected"),
+		codexCompactFailedDiagnostic(""),
+	}
+	for _, text := range texts {
+		if CodexResumeOverflowError(text) {
+			t.Errorf("diagnostic trips CodexResumeOverflowError: %q", text)
+		}
+		if CodexRetiredCompactionError(text) {
+			t.Errorf("diagnostic trips CodexRetiredCompactionError: %q", text)
+		}
+	}
+	// A genuinely retired-route compaction failure must still be identifiable
+	// once the provider detail is embedded — that pairing is the point of
+	// keeping the detail verbatim.
+	withRetiredRoute := codexCompactFailedDiagnostic(codexRetiredCompactionLiveError)
+	if !CodexRetiredCompactionError(withRetiredRoute) {
+		t.Errorf("embedded retired-route detail lost its classification: %q", withRetiredRoute)
+	}
+}
