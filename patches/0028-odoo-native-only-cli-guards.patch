+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"testing"
+
+	"github.com/spf13/cobra"
+)
+
+func projectOdooTestCmd() *cobra.Command {
+	cmd := &cobra.Command{}
+	cmd.SetOut(&bytes.Buffer{})
+	cmd.Flags().String("workspace-id", "", "")
+	cmd.Flags().String("profile", "", "")
+	cmd.Flags().String("server-url", "", "")
+	cmd.Flags().String("output", "json", "")
+	cmd.Flags().String("type", "", "")
+	cmd.Flags().String("local-path", "", "")
+	cmd.Flags().String("daemon-id", "", "")
+	cmd.Flags().String("ref-label", "", "")
+	cmd.Flags().String("execution-mode", "", "")
+	cmd.Flags().String("label", "", "")
+	return cmd
+}
+
+func TestRunProjectResourceAddUsesOdooBackendRoute(t *testing.T) {
+	const projectID = "42"
+	var gotPath string
+	var gotMethod string
+	var gotBody map[string]any
+	mcpTestServer(t, func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		gotMethod = r.Method
+		_ = json.NewDecoder(r.Body).Decode(&gotBody)
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"id":            "99",
+			"resource_type": "local_directory",
+		})
+	})
+	t.Setenv("MULTICA_BACKEND_MODE", "odoo")
+
+	cmd := projectOdooTestCmd()
+	cmd.Flags().Set("type", "local_directory")
+	cmd.Flags().Set("local-path", "/home/dev/workspace")
+	cmd.Flags().Set("daemon-id", "daemon-1")
+	cmd.Flags().Set("label", "Odoo checkout")
+	if _, err := captureStdout(t, func() error {
+		return runProjectResourceAdd(cmd, []string{projectID})
+	}); err != nil {
+		t.Fatalf("runProjectResourceAdd: %v", err)
+	}
+	if gotPath != "/multica/agent/projects/"+projectID+"/resources" {
+		t.Fatalf("path = %q, want the Odoo project resources route", gotPath)
+	}
+	if gotMethod != http.MethodPost {
+		t.Fatalf("method = %q, want POST", gotMethod)
+	}
+	if gotBody["resource_type"] != "local_directory" {
+		t.Fatalf("resource_type = %v", gotBody["resource_type"])
+	}
+	ref, _ := gotBody["resource_ref"].(map[string]any)
+	if ref["local_path"] != "/home/dev/workspace" || ref["daemon_id"] != "daemon-1" {
+		t.Fatalf("resource_ref = %v", gotBody["resource_ref"])
+	}
+	if gotBody["label"] != "Odoo checkout" {
+		t.Fatalf("label = %v", gotBody["label"])
+	}
+}
