+// RequireNativeBackend prevents commands whose API surface is not implemented
+// by the Odoo compatibility backend from falling through to an opaque 404.
+// Local-only commands do not call this method and remain available in either
+// backend mode.
+func (c *APIClient) RequireNativeBackend(feature string) error {
+	if c.OdooBackend {
+		return fmt.Errorf("%s is not supported with the Odoo backend", feature)
+	}
+	return nil
+}
+
