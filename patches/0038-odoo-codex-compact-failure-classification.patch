+// The capacity-failed turn remains in the diagnostic alongside the provider
+// failure. That combined text must not override the adapter's transient verdict.
+func TestCodexCompactionConfigurationFailureFreshFallback(t *testing.T) {
+	t.Parallel()
+	for _, detail := range []string{codexRetiredCompactionError, "summarization model unavailable", "stream disconnected"} {
+		t.Run(detail, func(t *testing.T) {
+			errMsg := "Codex ran out of room in the model's context window. " +
+				"[multica] codex could not finish compacting this conversation: " + detail +
+				". The conversation is kept; this run may continue on a fresh session and the thread recovers once codex compaction is available again."
+			first := agent.Result{Status: "failed", SessionID: "original", Error: errMsg, ResumeRejectedTransient: true}
+			if !shouldRetryWithFreshSession(first, "original", 0, "codex") {
+				t.Fatal("compaction configuration failure must allow the existing fresh fallback")
+			}
+			if shouldRetryWithFreshSession(first, "original", 1, "codex") {
+				t.Fatal("fresh fallback must retain the tool-use guard")
+			}
+			if _, unsafe := classifyPoisonedError(errMsg); unsafe {
+				t.Fatal("compaction configuration failure poisoned the session")
+			}
+			if _, unsafe := classifyResumeUnsafeTransport("codex", errMsg); unsafe {
+				t.Fatal("compaction configuration failure retired the session")
+			}
+			annotated := annotateCodexRetiredCompaction(errMsg, "codex")
+			if service.ResumeUnsafeFailure(taskfailure.Classify(errMsg).String(), annotated) {
+				t.Fatal("persisted diagnostic must leave the original session resumable")
+			}
+			failedRetry, _ := reconcileFreshRetryResult(first, nil, 0, agent.Result{Status: "failed", Error: "fresh attempt failed"}, 0, nil)
+			if failedRetry.SessionID != "original" || failedRetry.ResumeRejected || !failedRetry.ResumeRejectedTransient {
+				t.Fatalf("failed fresh fallback lost the recoverable original session: %+v", failedRetry)
+			}
+			succeeded, _ := reconcileFreshRetryResult(first, nil, 0, agent.Result{Status: "completed", SessionID: "fresh"}, 0, nil)
+			if succeeded.SessionID != "fresh" || succeeded.ResumeRejected || succeeded.ResumeRejectedTransient {
+				t.Fatalf("successful fallback must use its own session: %+v", succeeded)
+			}
+		})
+	}
+}
